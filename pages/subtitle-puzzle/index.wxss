.container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
}

/* Guide Page */
.guide-page {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  padding: 40rpx;
  box-sizing: border-box;
}

.guide-header {
  padding-top: 20rpx;
  margin-bottom: 40rpx;
}

.guide-title {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  color: #06B6D4;
  margin-bottom: 12rpx;
  line-height: 1.2;
}

.guide-subtitle {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  letter-spacing: 2rpx;
}

.guide-content {
  flex: 1;
  position: relative;
  width: 100%;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 40rpx;
}

.guide-hero-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.hero-text-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 60rpx 40rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
  gap: 32rpx;
}

.hero-text-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  width: 100%;
}

.hero-text-item .cn {
  color: rgba(255,255,255,0.95);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.6);
  margin-bottom: 4rpx;
}

.hero-text-item .en {
  color: rgba(255,255,255,0.85);
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.6);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

.guide-footer {
  padding: 20rpx 0 60rpx;
}

.start-btn {
  width: 100%;
  height: 108rpx;
  background: #2b85ff;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(43, 133, 255, 0.3);
  letter-spacing: 4rpx;
}

/* Preview Stack */
.preview-stack {
  flex: 1;
  width: 100%;
  background: #fff;
}

.images-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.stack-item {
  width: 100%;
  position: relative;
  overflow: hidden;
  /* border-bottom: 1px solid rgba(0,0,0,0.1); Optional separator? usually seamless */
}

.subtitle-overlay {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  pointer-events: none;
  z-index: 2;
}

.subtitle-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
  text-align: center;
  max-width: 90%;
}

.add-btn-area {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}

.add-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  background: #fff;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  gap: 16rpx;
}

.add-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.5;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  padding: 20rpx 30rpx calc(-2rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.border-settings {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.options-group, .color-options {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.option-btn {
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border: 2rpx solid transparent;
}

.option-btn.active {
  color: #06B6D4;
  background: rgba(6, 182, 212, 0.1);
  border-color: #06B6D4;
}

.color-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.color-btn.color-white {
  background: #ffffff;
  border: 2rpx solid #ddd;
}

.color-btn.active {
  border: 4rpx solid #06B6D4;
  transform: scale(1.1);
}

.action-btn {
  width: 88%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.action-btn.primary {
  background: #06B6D4;
  color: #fff;
}

/* Modal */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 90%;
  max-height: 90vh;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}

.modal-header text {
  font-size: 32rpx;
  font-weight: bold;
}

.close-btn {
  padding: 10rpx;
}

.icon-small {
  width: 32rpx;
  height: 32rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.image-preview-wrapper {
  position: relative;
  width: 100%;
  border-radius: 8rpx;
  overflow: hidden;
  background: #eee;
  margin-bottom: 30rpx;
}

.preview-source-image {
  width: 100%;
  display: block;
}

.mask-top, .mask-bottom {
  position: absolute;
  left: 0;
  width: 100%;
  background: rgba(0, 0, 0, 0.5);
  pointer-events: none;
}

.mask-top { top: 0; }
.mask-bottom { bottom: 0; }

.guide-line-top, .guide-line-bottom {
  position: absolute;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: #06B6D4;
  pointer-events: none;
  z-index: 2;
  box-shadow: 0 0 8rpx rgba(6, 182, 212, 0.5);
}

.crop-handle {
  position: absolute;
  left: 0;
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.crop-handle.top {
  margin-top: -40rpx;
}

.crop-handle.bottom {
  margin-top: -40rpx;
}

.handle-bar {
  width: 120rpx;
  height: 16rpx;
  background: #06B6D4;
  border-radius: 8rpx;
  border: 3rpx solid #ffffff;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.handle-bar::before, .handle-bar::after {
  content: '';
  width: 4rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 2rpx;
}

.edit-toolbar {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  padding: 20rpx 0;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.tool-icon {
  width: 48rpx;
  height: 48rpx;
}

.tool-item text {
  font-size: 24rpx;
  color: #333;
}

.controls {
  margin-bottom: 20rpx;
}

.slider-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label {
  font-size: 26rpx;
  color: #666;
  width: 80rpx;
}

.slider {
  flex: 1;
  margin: 0 0 0 20rpx;
}

.text-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.subtitle-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.random-btn {
  width: 80rpx;
  height: 80rpx;
  background: #f0f7ff;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.modal-footer {
  padding: 30rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  gap: 20rpx;
}

.footer-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.footer-btn.delete {
  background: #ffebeb;
  color: #ff4d4f;
}

.footer-btn.confirm {
  background: #06B6D4;
  color: #fff;
}

.offscreen-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
}
