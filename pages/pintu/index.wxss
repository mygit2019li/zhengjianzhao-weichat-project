.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
  overflow: hidden;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 178rpx;
  padding: 0 20rpx;
  background-color: #06B6D4;
  flex-shrink: 0;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  padding-top: 70rpx;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  padding-top: 70rpx;
}

.nav-placeholder {
  width: 64rpx;
}

/* 提示文字 */
.tip-txt {
  text-align: center;
  padding: 20rpx 0;
  background-color: #f5f5f5;
}

.tip-txt text {
  font-size: 24rpx;
  color: #666;
}

.preview-area {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: visible;
  position: relative;
}

.preview-tips {
  width: 100%;
  text-align: center;
  color: #9cb2bc;
  font-size: 48rpx;
  transform: scale(0.5);
  transform-origin: center top;
  margin-top: 8rpx;
}



/* 画布样式 */
.puzzle-canvas {
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.12), 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  transition: all 0.3s ease;
  position: relative;
}

/* 空状态 */
.empty-state {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
}

.upload-icon {
  width: 120rpx;
  height: 120rpx;
  border: 4rpx dashed rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
}

.upload-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 图片布局样式 */
.image-layout {
  width: 100%;
  height: 100%;
  position: relative;
}

.draggable-image-container {
  overflow: hidden;
  position: absolute;
  background-color: transparent;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

/* 使用伪元素实现边框，避免相邻图片边框叠加 */
.draggable-image-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 分隔线由画布背景和格子间距承担，避免相邻图片边框叠加变粗 */
  border: 0 solid transparent;
  border-radius: inherit;
  pointer-events: none;
  z-index: 1;
  box-sizing: border-box;
}

.draggable-image-container.selected {
  z-index: 10;
}

.draggable-image-container.selected::before {
  border: 0 solid transparent;
  box-shadow: inset 0 0 0 4rpx #06B6D4, 0 0 0 2rpx rgba(6, 182, 212, 0.3);
}

.draggable-image-container.is-dragging {
  opacity: 0.72;
  transform: scale(0.97);
  z-index: 20;
}

.draggable-image-container.is-drag-over::before {
  box-shadow: inset 0 0 0 6rpx rgba(6, 182, 212, 0.95), 0 0 0 4rpx rgba(6, 182, 212, 0.24);
}

.draggable-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transition: none;
  display: block;
  transform-origin: center center;
}

.preview-border-line {
  position: absolute;
  pointer-events: none;
  z-index: 2;
}

/* 操作浮窗 */
.operation-bar {
  position: absolute;
  display: block;
  padding: 14rpx 18rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 22rpx;
  z-index: 1000;
  white-space: nowrap;
  box-shadow: 0 18rpx 46rpx rgba(15, 23, 42, 0.2);
  backdrop-filter: blur(12rpx);
  box-sizing: border-box;
}

.close-btn {
  position: absolute;
  top: -18rpx;
  right: -18rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #111827;
  border: 4rpx solid #ffffff;
  color: #ffffff;
  font-size: 32rpx;
  line-height: 38rpx;
  text-align: center;
  z-index: 1001;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.22);
}

.ops-row {
  display: flex;
  gap: 10rpx;
  align-items: center;
  justify-content: space-between;
}

.op-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  transition: all 0.15s ease;
  background: #f3f6fa;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.op-btn:active {
  transform: translateY(1rpx) scale(0.98);
  background: #eaf2ff;
}

.op-btn.delete .op-text {
  color: #ef4444;
}

.op-text {
  font-size: 24rpx;
  color: #1f2937;
  line-height: 1.1;
  font-weight: 600;
}

.grid-container {
  width: 100%;
  height: 100%;
  background-color: transparent;
  position: relative;
  box-sizing: border-box;
  overflow: visible;
}

/* 完整模式：无边框 */
.grid-container.full-ratio {
}

.grid-slot {
  position: absolute;
  box-sizing: border-box;
  overflow: hidden;
  background-color: transparent;
  border: 2rpx solid rgba(6, 182, 212, 0.4);
}

.grid-slot.has-img {
  border: 2rpx solid rgba(6, 182, 212, 0.6);
}

.grid-slot.is-selected {
  border: 4rpx solid #06B6D4;
  z-index: 10;
  box-shadow: 0 0 0 2rpx rgba(6, 182, 212, 0.3);
}

/* .grid-container.full-ratio .grid-slot {
  overflow: visible;
} */

.slot-img {
  width: 100%;
  height: 100%;
  display: block;
  transform-origin: center center;
  transition: transform 0.12s ease;
}

/* 完整比例模式下使用 object-fit: contain 显示完整图片 */
.grid-container.full-ratio .slot-img {
  object-fit: contain;
}

.grid-slot.is-selected {
  z-index: 10;
}

.slot-img.is-selected-img {
  border: 6rpx solid #FFD700;
  box-sizing: border-box;
}

.grid-slot.is-dragging {
  opacity: 0.65;
}

.grid-slot.is-drag-over {
  box-shadow: inset 0 0 0 4rpx rgba(6, 182, 212, 0.9);
}

.slot-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.grid-container.full-ratio .slot-placeholder {
  background: transparent;
}

.plus-icon {
  font-size: 60rpx;
  color: #ccc;
  font-weight: 300;
}

.slot-placeholder-text {
  font-size: 56rpx;
  transform: scale(0.5);
  transform-origin: center center;
  color: #4d4d4d;
  font-weight: 600;
}

.delete-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
  color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  z-index: 10;
}

/* 图片操作浮动菜单 - 显示在选中图片外部 */
.image-action-float {
  position: absolute;
  transform: translate(-50%, 8rpx);
  display: flex;
  gap: 2rpx;
  padding: 8rpx;
  background: linear-gradient(180deg, rgba(34, 37, 44, 0.96) 0%, rgba(25, 27, 32, 0.96) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  z-index: 1000;
  white-space: nowrap;
  box-shadow: 0 10rpx 28rpx rgba(11, 15, 22, 0.38);
  backdrop-filter: blur(10px);
}

.float-close-btn {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(20, 22, 28, 0.96);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
}

.float-action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  min-height: 90rpx;
  padding: 8rpx 8rpx 6rpx;
  border-radius: 16rpx;
  transition: all 0.15s ease;
}

.float-action-btn:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.08);
}

.float-action-btn + .float-action-btn {
  border-left: 1rpx solid rgba(255, 255, 255, 0.1);
}

.float-action-btn .float-action-icon-img {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 6rpx;
  opacity: 0.92;
}

.float-action-btn.danger .float-action-text {
  color: #ff6b6b;
}

.float-action-btn.danger .float-action-icon-img {
  opacity: 1;
}

.float-action-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.1;
  font-weight: 600;
}

.floating-add-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #ffffff;
  color: #404040;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  border: 1rpx solid #efefef;
  z-index: 110;
}

.floating-add-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.floating-add-text {
  font-size: 26rpx;
  font-weight: 600;
}

.text-overlay {
  position: absolute;
  transform: translate(-50%, -50%);
  max-width: 86%;
  z-index: 20;
  white-space: pre-wrap;
  line-height: 1.35;
  word-break: break-all;
}

.single-edit-panel {
  margin: 12rpx auto 0;
  width: 100%;
  max-width: 690rpx;
  background: #ffffff;
  border: 2rpx solid #e9f6ee;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}

.single-edit-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.single-edit-title {
  font-size: 24rpx;
  color: #1f2937;
  font-weight: 600;
}

.single-edit-close {
  font-size: 22rpx;
  color: #07c160;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #edf9f1;
}

.single-edit-actions {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.single-action-btn {
  flex: 1;
  text-align: center;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 10rpx;
  border: 2rpx solid #ececec;
  font-size: 22rpx;
  color: #374151;
  background: #fafafa;
}

.single-action-btn.danger {
  color: #ff4d4f;
  border-color: #ffd6d6;
  background: #fff5f5;
}

.single-scale-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.single-scale-label {
  font-size: 24rpx;
  color: #4b5563;
}

.controls-area {
  position: relative;
  background-color: #fff;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  box-shadow: 0 -2rpx 10rpx rgba(9, 30, 66, 0.04);
  z-index: 100;
  border-top: 2rpx solid #f1f1f1;
  box-sizing: border-box;
  flex-shrink: 0;
}

.ratio-section {
  padding: 3rpx 13rpx;
  border-bottom: 1rpx solid #f5f5f5;
  flex-shrink: 0;
}

.ratio-scroll {
  white-space: nowrap;
  height: 88rpx;
  display: flex;
}

.feature-panel {
  height: 197rpx;
  overflow: hidden;
  border-bottom: 1rpx solid #f5f5f5;
  box-sizing: border-box;
}

.feature-view {
  height: 100%;
  box-sizing: border-box;
  overflow-y: auto;
  border-bottom: none;
}

.ratio-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  vertical-align: middle;
}

.ratio-box {
  height: 60rpx;
  min-width: 60rpx;
  border: 3rpx solid #666;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
  position: relative;
  background: transparent;
  transition: all 0.2s;
}

.ratio-text {
  font-size: 22rpx;
  color: #666;
  font-weight: bold;
  white-space: nowrap;
  line-height: 1;
}

/* Active State */
.ratio-item.active .ratio-box {
  border-color: #333;
  background: #fff9df;
}

.ratio-item.active .ratio-text {
  color: #333;
}

/* Full Mode Specifics */
.ratio-full {
  width: 60rpx;
  height: 60rpx;
  border: none !important;
  background: transparent;
}

.ratio-item.active .ratio-full {
  background: #fff9df;
  border-radius: 8rpx;
}

.corner {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-style: solid;
  border-color: #666;
}

.ratio-item.active .corner {
  border-color: #333;
}

.tl { top: 0; left: 0; border-width: 3rpx 0 0 3rpx; border-top-left-radius: 6rpx; }
.tr { top: 0; right: 0; border-width: 3rpx 3rpx 0 0; border-top-right-radius: 6rpx; }
.bl { bottom: 0; left: 0; border-width: 0 0 3rpx 3rpx; border-bottom-left-radius: 6rpx; }
.br { bottom: 0; right: 0; border-width: 0 3rpx 3rpx 0; border-bottom-right-radius: 6rpx; }



.template-section {
  padding: 10rpx 0 6rpx;
}

.template-scroll {
  white-space: nowrap;
  padding: 0 12rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
}

.template-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 12rpx;
  padding: 6rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 8rpx;
}

.template-item.active {
  border-color: #07c160;
}

.template-preview {
  width: 82rpx;
  height: 82rpx;
  position: relative;
  background: #eef7f3;
  border-radius: 4rpx;
  overflow: hidden;
}

.mini-slot {
  position: absolute;
  background: #ddd;
  border: 1rpx solid #fff;
  box-sizing: border-box;
}

.template-item.active .mini-slot {
  background: #a5e0b8;
}

/* 布局选项样式 */
.panel {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.panel-title {
  font-size: 24rpx;
  color: #1f2937;
  font-weight: 600;
  margin-bottom: 14rpx;
  padding: 0 20rpx;
}

.layout-tip {
  padding: 48rpx;
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: linear-gradient(135deg, rgba(248, 248, 248, 0.5) 0%, rgba(240, 240, 240, 0.5) 100%);
  border-radius: 24rpx;
  border: 2rpx dashed #e0e0e0;
  margin: 20rpx;
}

.layout-options {
  display: flex;
  white-space: nowrap;
  padding: 0 12rpx;
  height: 120rpx;
  align-items: center;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.layout-options::-webkit-scrollbar {
  display: none;
}

.layout-option {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 12rpx;
  padding: 6rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 8rpx;
  background: #ffffff;
  transition: all 0.2s;
}

.layout-option.active {
  border-color: #07c160;
}

.layout-preview {
  width: 82rpx;
  height: 82rpx;
  position: relative;
  background: #eef7f3;
  border-radius: 4rpx;
  overflow: hidden;
  display: flex;
  gap: 2rpx;
  padding: 4rpx;
}

.layout-preview.vertical {
  flex-direction: column;
}

.layout-preview.horizontal {
  flex-direction: row;
}

.layout-preview .preview-cell {
  flex: 1;
  background: #ddd;
  border: 1rpx solid #fff;
  box-sizing: border-box;
}

.layout-option.active .preview-cell {
