}

.layout-label {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #4b5563;
  transform: scale(0.5);
  transform-origin: center top;
  height: 10rpx;
}

/* 各种布局预览样式 */
.layout-preview.grid-2x2 {
  flex-direction: column;
}
.layout-preview.grid-2x2 .preview-row {
  flex: 1; display: flex; gap: 2rpx;
}

.layout-preview.four-top {
  flex-direction: column;
}
.layout-preview.four-top .large { flex: 2; }
.layout-preview.four-top .preview-row { flex: 1; display: flex; gap: 2rpx; }

.layout-preview.grid-2-3 {
  flex-direction: column;
}
.layout-preview.grid-2-3 .preview-row:first-child { flex: 2; display: flex; gap: 2rpx; }
.layout-preview.grid-2-3 .preview-row:last-child { flex: 3; display: flex; gap: 2rpx; }

.layout-preview.left-2-3 {
  flex-direction: row;
}
.layout-preview.left-2-3 .preview-col:first-child { flex: 2; display: flex; flex-direction: column; gap: 2rpx; }
.layout-preview.left-2-3 .preview-col:last-child { flex: 3; display: flex; flex-direction: column; gap: 2rpx; }

.layout-preview.grid-2x3 {
  flex-direction: column;
}
.layout-preview.grid-2x3 .preview-row { flex: 1; display: flex; gap: 2rpx; }

.layout-preview.triple-left {
  flex-direction: row;
}
.layout-preview.triple-left .large { flex: 2; }
.layout-preview.triple-left .preview-col { flex: 1; display: flex; flex-direction: column; gap: 2rpx; }

.layout-preview.triple-right {
  flex-direction: row;
}
.layout-preview.triple-right .large { flex: 2; }
.layout-preview.triple-right .preview-col { flex: 1; display: flex; flex-direction: column; gap: 2rpx; }

/* 7-9 图布局预览 */
.layout-preview.grid-3-4 {
  flex-direction: column;
}
.layout-preview.grid-3-4 .preview-row:first-child { flex: 3; display: flex; gap: 2rpx; }
.layout-preview.grid-3-4 .preview-row:last-child { flex: 4; display: flex; gap: 2rpx; }

.layout-preview.grid-4-3 {
  flex-direction: column;
}
.layout-preview.grid-4-3 .preview-row:first-child { flex: 4; display: flex; gap: 2rpx; }
.layout-preview.grid-4-3 .preview-row:last-child { flex: 3; display: flex; gap: 2rpx; }

.layout-preview.top-one-7 {
  flex-direction: column;
}
.layout-preview.top-one-7 .large { flex: 1; width: 100%; }
.layout-preview.top-one-7 .preview-row { flex: 1; display: flex; gap: 2rpx; }

.layout-preview.grid-3-3-2 {
  flex-direction: column;
}
.layout-preview.grid-3-3-2 .preview-row { flex: 1; display: flex; gap: 2rpx; }
.layout-preview.grid-3-3-2 .preview-row:last-child { display: flex; justify-content: flex-start; gap: 2rpx; }
.layout-preview.grid-3-3-2 .preview-row:last-child .preview-cell { flex: 0 0 49%; }

.layout-preview.grid-4-4 {
  flex-direction: column;
}
.layout-preview.grid-4-4 .preview-row { flex: 1; display: flex; gap: 2rpx; }

.layout-preview.grid-3x3 {
  flex-direction: column;
}
.layout-preview.grid-3x3 .preview-row { flex: 1; display: flex; gap: 2rpx; }

.layout-preview.triple-top {
  flex-direction: column;
}
.layout-preview.triple-top .large { flex: 2; }
.layout-preview.triple-top .preview-row { flex: 1; display: flex; gap: 2rpx; }

.layout-preview.triple-bottom {
  flex-direction: column;
}
.layout-preview.triple-bottom .preview-row { flex: 1; display: flex; gap: 2rpx; }
.layout-preview.triple-bottom .large { flex: 2; }

/* 单图布局 */
.layout-preview.single {
  flex-direction: column;
}
.layout-preview.single .preview-cell.full {
  flex: 1;
  width: 100%;
  height: 100%;
}

.template-name {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #4b5563;
  transform: scale(0.5);
  transform-origin: center top;
  height: 10rpx;
}

/* 边框面板 */
.border-section {
  padding: 20rpx 40rpx;
}

/* 边框设置行 - 宽度和颜色在一行 */
.border-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

/* 紧凑的边框宽度选择 */
.border-width-compact {
  display: flex;
  gap: 8rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 6rpx;
}

.width-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  background: transparent;
  transition: all 0.2s;
}

.width-btn.active {
  background: #06B6D4;
}

.width-btn text {
  font-size: 20rpx;
  color: #666666;
}

.width-btn.active text {
  color: #ffffff;
  font-weight: 600;
}

.width-line {
  width: 24rpx;
  background: #666666;
  border-radius: 2rpx;
}

.width-btn.active .width-line {
  background: #ffffff;
}

.width-line.thin {
  height: 2rpx;
}

.width-line.medium {
  height: 4rpx;
}

.width-line.thick {
  height: 8rpx;
}

/* 紧凑的边框颜色选择 */
.border-color-compact {
  display: flex;
  gap: 12rpx;
  flex: 1;
  justify-content: flex-end;
}

.color-dot-small {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
  transition: all 0.2s;
}

.color-dot-small.active {
  outline: 3rpx solid #07c160;
  outline-offset: 2rpx;
}

/* 旧的样式保留兼容 */
.border-width-options {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.border-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.border-option.active {
  background: #e0f7fa;
  border: 2rpx solid #06B6D4;
}

.border-preview {
  width: 64rpx;
  height: 64rpx;
  background: #06B6D4;
  border-radius: 8rpx;
}

.border-preview.no-border {
  border: none;
}

.border-preview.small-border {
  border: 2rpx solid #ffffff;
}

.border-preview.medium-border {
  border: 4rpx solid #ffffff;
}

.border-preview.large-border {
  border: 8rpx solid #ffffff;
}

.border-label {
  font-size: 24rpx;
  color: #666666;
}

.border-option.active .border-label {
  color: #06B6D4;
  font-weight: 600;
}

/* 边框颜色选项 */
.border-color-options {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
}

.color-option {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
  transition: all 0.2s;
}

.color-option.active {
  outline: 4rpx solid #07c160;
}

/* 边框圆角滑块 */
.border-radius-slider {
  padding: 10rpx 0;
}

/* 文字面板 */
.text-section {
  padding: 20rpx 30rpx;
}

.text-options {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.text-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.text-icon-add {
  width: 64rpx;
  height: 64rpx;
  background: #06B6D4;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.text-label {
  font-size: 24rpx;
  color: #666666;
}

/* 文字列表 */
.text-list {
  max-height: 200rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.text-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.text-content {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  color: #06B6D4;
}

.action-btn.delete {
  color: #FF6B6B;
}

.slider-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.slider-label {
  font-size: 26rpx;
  color: #666;
  width: 100rpx;
}

.slider-control {
  flex: 1;
  margin: 0;
}

.text-input-wrap {
  margin-bottom: 14rpx;
  border: 2rpx solid #ececec;
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
}

.text-input {
  width: 100%;
  height: 90rpx;
  font-size: 26rpx;
  color: #333;
}

.add-text-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  border-radius: 8rpx;
}

.add-text-btn:active {
  background: #e0e0e0;
}

/* 文字叠加层样式 */
.text-overlay {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 20;
  pointer-events: auto;
  white-space: pre-wrap;
  line-height: 1.35;
  word-break: break-all;
}

.text-content-wrapper {
  display: inline-block;
  box-sizing: border-box;
  max-width: none;
  padding: 0;
  border: none;
  background: transparent;
}

/* 紧凑行布局 */
.compact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.control-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.control-label {
  font-size: 26rpx;
  color: #666;
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 8rpx;
  overflow: hidden;
  height: 60rpx;
}

.stepper-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.stepper-btn:active {
  background: #e0e0e0;
}

.stepper-value {
  width: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 样式按钮组 */
.style-group {
  display: flex;
  gap: 16rpx;
}

.mini-btn {
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: #f4f5f7;
  color: #555;
  font-size: 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.mini-btn-active {
  color: #fff;
  background: #07c160;
}

/* 颜色行 */
.color-row-compact {
  display: flex;
  gap: 16rpx;
}

.color-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
}

.color-dot-active {
  outline: 4rpx solid #07c160;
}

.style-group .mini-btn {
  width: 80rpx;
  height: 60rpx;
  padding: 0;
  border-radius: 8rpx;
  font-weight: bold;
  font-size: 24rpx;
}

.mini-btn {
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: #f4f5f7;
  color: #555;
  font-size: 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.mini-btn-active {
  color: #fff;
  background: #07c160;
}

.color-row-compact .color-dot {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
}

/* Edit Tools */
.edit-section {
  padding: 26rpx 40rpx;
}

.edit-tools-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 60rpx;
}

.edit-tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.edit-tool-item:active {
  opacity: 0.7;
}

.tool-icon-circle {
  width: 85rpx;
  height: 85rpx;
  background: #f7f8fa;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-icon {
  width: 50rpx;
  height: 50rpx;
}

.tool-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.color-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
}

.color-dot-active {
  outline: 4rpx solid #07c160;
}

.bottom-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 3rpx 32rpx 24rpx;
  min-height: 110rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.tabs {
  display: flex;
  gap: 40rpx;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  opacity: 0.6;
  padding: 0 10rpx;
}

.tab-item.active {
  opacity: 1;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-item text {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
}

.save-btn {
  background: linear-gradient(90deg, #ff9800 0%, #ff5b00 100%);
  color: #fff;
  padding: 0 40rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(255, 91, 0, 0.25);
}

.offscreen-canvas {
  position: fixed;
  left: 9999px;
  top: 0;
  width: 600px;
  height: 600px;
}

/* 缩放滑块弹窗 */
.scale-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.scale-popup.show {
  opacity: 1;
  visibility: visible;
}

.popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.popup-content {
  position: relative;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.scale-popup.show .popup-content {
  transform: translateY(0);
}

.popup-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.popup-close {
  text-align: center;
  padding: 24rpx;
  font-size: 30rpx;
  color: #666;
  background: #f7f8fa;
  border-radius: 16rpx;
  margin-top: 10rpx;
}

.popup-close:active {
  background: #e8e8e8;
}

/* 缩放滑块 */
.scale-slider-wrap {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

.scale-min,
.scale-max {
  font-size: 24rpx;
  color: #999;
  width: 80rpx;
  text-align: center;
}

.scale-slider {
  flex: 1;
}

/* Stepper Control */
.stepper {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 8rpx;
  overflow: hidden;
  height: 60rpx;
}

.stepper-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.stepper-btn:active {
  background: #e0e0e0;
}

.stepper-value {
  width: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* Compact Text Controls */
.compact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.control-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.control-label {
  font-size: 26rpx;
  color: #666;
}

.style-group {
  display: flex;
  gap: 16rpx;
}

.color-row-compact {
  display: flex;
  gap: 16rpx;
}

/* 交换模式提示 */
.swap-mode-hint {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.75);
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 1000;
  backdrop-filter: blur(10px);
}

.swap-mode-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.swap-mode-cancel {
  font-size: 26rpx;
  color: #ff6b6b;
  font-weight: 600;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
}
