.container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 8% 6%, rgba(59, 130, 246, 0.08), transparent 36%),
    radial-gradient(circle at 92% 12%, rgba(16, 185, 129, 0.08), transparent 32%),
    linear-gradient(180deg, #f8fafc 0%, #eef3f9 48%, #e9eef5 100%);
  padding: 26rpx 24rpx 18rpx;
  box-sizing: border-box;
}

.header {
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
  backdrop-filter: blur(8rpx);
}

.title {
  font-size: 42rpx;
  color: #111827;
  font-weight: 700;
  letter-spacing: 0.4rpx;
}

.desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #5b6472;
  line-height: 1.65;
}

.grid {
  display: grid;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  padding: 14rpx;
  border-radius: 0;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(8rpx);
  /* 宽度与切图框选页一致，高度由内容自适应 */
  width: 650rpx;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  /* 确保列宽平均分配 */
  justify-content: stretch;
  /* 缩放由 JS 动态计算 transform: scale() 控制 */
  transform-origin: top center;
}

.grid-item {
  position: relative;
  background: #dfe6f2;
  border-radius: 0;
  overflow: hidden;
  border: 2rpx solid rgba(99, 102, 241, 0);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.4);
  transition: all 0.18s ease;
  /* aspect-ratio 由 WXML 动态设置，确保每个格子保持正确比例 */
  width: 100%;
}

.grid-item.active {
  border-color: rgba(14, 116, 246, 0.95);
  box-shadow:
    0 0 0 4rpx rgba(14, 116, 246, 0.16),
    0 10rpx 26rpx rgba(14, 116, 246, 0.18);
}

.grid-item.dragging {
  opacity: 0.85;
  transform: scale(0.98);
}

.img-viewport {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 0;
}

.grid-image {
  width: 100%;
  height: 100%;
  transition: transform 0.14s ease;
}

.index-badge {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  min-width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(15, 23, 42, 0.56);
  border-radius: 999rpx;
  padding: 0 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(6rpx);
}

.tool-icon {
  width: 30rpx;
  height: 30rpx;
}

.image-action-modal {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.image-action-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.58);
  backdrop-filter: blur(8rpx);
}

.image-action-panel {
  position: relative;
  z-index: 1;
  width: 640rpx;
  max-width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 28rpx 80rpx rgba(15, 23, 42, 0.28);
}

.image-action-header {
  position: relative;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: 72rpx;
  box-sizing: border-box;
}

.image-action-buttons {
  display: flex;
  gap: 14rpx;
}

.image-action-btn {
  min-width: 116rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #111827;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.image-action-btn:active,
.image-action-close:active {
  opacity: 0.82;
}

.image-action-close {
  position: absolute;
  top: 8rpx;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #eef2f7;
  color: #111827;
  font-size: 42rpx;
  font-weight: 300;
}

.image-action-preview {
  position: relative;
  width: 100%;
  max-width: 100%;
  max-height: 60vh;
  margin-top: 20rpx;
  overflow: hidden;
  background: #dfe6f2;
  border-radius: 0;
  /* aspect-ratio 由 WXML 动态设置 */
  /* 确保高度由 aspect-ratio 决定 */
  height: auto;
  /* 超出最大高度时保持比例缩放 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-action-preview-img {
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 60vh;
  object-fit: contain;
  transition: transform 0.14s ease;
}

.image-action-index {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  min-width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: rgba(15, 23, 42, 0.62);
  border-radius: 999rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(6rpx);
}

.footer {
  margin-top: 26rpx;
  display: flex;
  gap: 16rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
}

.main-btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 14rpx 24rpx rgba(15, 23, 42, 0.13);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0;
}

.main-btn:active {
  transform: translateY(1rpx);
}

.main-btn::after,
.image-action-btn::after {
  border: none;
}

.main-btn.save {
  background: linear-gradient(135deg, #16a34a 0%, #14b86a 100%);
  color: #ffffff;
}

.main-btn.share {
  background: linear-gradient(135deg, #0f87c9 0%, #2563eb 100%);
  color: #ffffff;
}
