<view class="container">
  <!-- Copywriting Tab -->
  <view class="tab-content copywriting-content" wx:if="{{activeTab === 'copy'}}">
    <!-- Category Scroll -->
    <scroll-view scroll-x class="copy-category-scroll" enable-flex>
      <view 
        wx:for="{{copyCategories}}" 
        wx:key="*this"
        class="copy-category-item {{currentCopyCategory === item ? 'active' : ''}}"
        bindtap="selectCopyCategory"
        data-category="{{item}}"
      >{{item}}</view>
    </scroll-view>

    <!-- Copy List -->
    <scroll-view scroll-y class="copy-list-scroll">
      <view class="moments-item" wx:for="{{displayCopyItems}}" wx:key="index">
        <!-- Avatar -->
        <image class="moments-avatar" src="/images/头像.png" mode="aspectFill"></image>
        
        <!-- Content -->
        <view class="moments-content">
          <!-- Nickname -->
          <view class="moments-nickname">精选文案</view>
          
          <!-- Text -->
          <view class="moments-text {{item.isExpanded ? 'expanded' : (item.showExpandBtn ? 'collapsed' : '')}}" wx:if="{{item.text}}">
            <text user-select>{{item.text}}</text>
          </view>
          
          <!-- Expand/Collapse Button -->
          <view class="expand-btn" wx:if="{{item.showExpandBtn}}" catchtap="toggleText" data-index="{{index}}">
            {{item.isExpanded ? '收起' : '全文'}}
          </view>
          
          <!-- Images Grid -->
          <view class="moments-images-box" wx:if="{{item.images && item.images.length > 0}}">
            <!-- Single Image -->
            <image 
              wx:if="{{item.images.length === 1}}" 
              src="{{item.images[0]}}" 
              mode="widthFix" 
              class="moments-single-image"
              bindtap="previewImage"
              data-src="{{item.images[0]}}"
              data-urls="{{item.images}}"
            ></image>
            
            <!-- Multiple Images -->
            <view class="moments-image-grid {{item.images.length === 4 ? 'grid-4' : ''}}" wx:else>
              <image 
                wx:for="{{item.images}}" 
                wx:for-item="img" 
                wx:for-index="imgIndex"
                wx:key="*this" 
                src="{{img}}" 
                mode="aspectFill" 
                class="moments-grid-image"
                bindtap="previewImage"
                data-src="{{img}}"
                data-urls="{{item.images}}"
              ></image>
            </view>
          </view>

          <!-- Footer Actions -->
          <view class="moments-footer">
            <view class="moments-time">刚刚</view>
            <view class="moments-actions">
              <view class="action-btn copy-btn" catchtap="copyToClipboard" data-content="{{item.text}}">
                <text>复制文案</text>
              </view>
              <view class="action-btn download-btn" catchtap="downloadAllImages" data-index="{{index}}" wx:if="{{item.images && item.images.length > 0}}">
                <image class="btn-icon" src="/images/icon/下载.svg" mode="aspectFit"></image>
                <text>下载图片</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <view class="copy-hint" wx:if="{{displayCopyItems.length === 0}}">暂无相关文案</view>
      <view style="height: 100rpx;"></view> <!-- Bottom padding -->
    </scroll-view>
  </view>

  <!-- Image Cutting Tab -->
  <view class="tab-content grid-content" wx:if="{{activeTab === 'grid'}}">
    <!-- Hint Text -->
    <view class="hint-text">
      <text>拖动裁剪框调整位置，边角和边框可缩放</text>
    </view>

  <!-- 9-Grid Preview Area -->
  <view class="preview-container" id="preview-container">
    <!-- Shape Hint (Top Badge) -->
    <view wx:if="{{showShapeHint}}" class="shape-hint-badge">
      <text class="hint-icon">✨</text>
      <text class="hint-text">{{currentShapeName}}效果将在保存时应用</text>
    </view>
    
    <view class="grid-wrapper">
      <!-- Background Image -->
      <image 
        wx:if="{{imagePath}}"
        class="bg-image" 
        src="{{imagePath}}" 
        mode="aspectFit"
      ></image>
      
      <!-- Placeholder when no image -->
      <view wx:else class="placeholder" bindtap="chooseImage">
        <text class="placeholder-icon">🖼️</text>
        <text class="placeholder-text">点击选择图片</text>
      </view>

      <!-- Crop Box -->
      <view 
        wx:if="{{imagePath}}"
        class="crop-box" 
        style="width: {{cropW}}px; height: {{cropH}}px; left: {{cropX}}px; top: {{cropY}}px; {{maskStyle}}"
        bindtouchstart="startBoxTouch"
        catchtouchmove="onBoxMove"
        bindtouchend="endBoxTouch"
        bindtouchcancel="endBoxTouch"
      >
        <!-- Grid Lines -->
        <view class="grid-lines">
          <!-- Horizontal Lines -->
          <block wx:for="{{gridRows - 1}}" wx:key="index">
            <view class="grid-line horizontal" style="top: {{(index + 1) / gridRows * 100}}%;"></view>
          </block>
          <!-- Vertical Lines -->
          <block wx:for="{{gridCols - 1}}" wx:key="index">
            <view class="grid-line vertical" style="left: {{(index + 1) / gridCols * 100}}%;"></view>
          </block>
        </view>
        
        <!-- Shape Overlay for Preview -->
        <view wx:if="{{showShapeOverlay}}" class="shape-overlay">
          <image class="shape-overlay-image" src="{{shapeOverlayUrl}}" mode="scaleToFill"></image>
        </view>

        <!-- Corner Handles -->
        <view class="corner top-left" catchtouchstart="startResize" catchtouchmove="onResize" catchtouchend="endResize" data-corner="tl"></view>
        <view class="corner top-right" catchtouchstart="startResize" catchtouchmove="onResize" catchtouchend="endResize" data-corner="tr"></view>
        <view class="corner bottom-left" catchtouchstart="startResize" catchtouchmove="onResize" catchtouchend="endResize" data-corner="bl"></view>
        <view class="corner bottom-right" catchtouchstart="startResize" catchtouchmove="onResize" catchtouchend="endResize" data-corner="br"></view>
        
        <!-- Edge Handles -->
        <view class="edge bottom" catchtouchstart="startResize" catchtouchmove="onResize" catchtouchend="endResize" data-corner="bottom"></view>
        <view class="edge right" catchtouchstart="startResize" catchtouchmove="onResize" catchtouchend="endResize" data-corner="right"></view>
      </view>
      
      <!-- Mask Overlay (Darkened area outside crop) -->
      <block wx:if="{{imagePath}}">
        <view class="mask top" style="height: {{cropY}}px;"></view>
        <view class="mask bottom" style="top: {{cropY + cropH}}px;"></view>
        <view class="mask left" style="width: {{cropX}}px; top: {{cropY}}px; height: {{cropH}}px;"></view>
        <view class="mask right" style="left: {{cropX + cropW}}px; top: {{cropY}}px; height: {{cropH}}px;"></view>
      </block>
    </view>
  </view>

  <!-- Bottom Action Buttons -->
  <view class="action-buttons">
    <view class="tip-text">注：保存后发布朋友圈时该图序列将9张图片</view>
    <view class="button-group">
      <button class="action-btn select-btn" bindtap="chooseImage">选择图片</button>
      <button class="action-btn save-btn" bindtap="startCut" disabled="{{!imagePath}}">开始切图</button>
    </view>
  </view>

  <!-- Grid Template Selector -->
  <view class="grid-selector-container">
    <view class="selector-label">选择宫格</view>
    <scroll-view scroll-x class="grid-scroll" enable-flex>
      <view
        wx:for="{{gridList}}"
        wx:key="id"
        class="grid-item {{selectedGridId === item.id ? 'active' : ''}}"
        bindtap="selectGrid"
        data-id="{{item.id}}"
        data-rows="{{item.rows}}"
        data-cols="{{item.cols}}"
      >
        <view class="grid-preview">
          <view class="grid-preview-inner" style="grid-template-columns: repeat({{item.cols}}, 1fr); grid-template-rows: repeat({{item.rows}}, 1fr);">
            <view wx:for="{{item.rows * item.cols}}" wx:key="*this" class="grid-preview-cell"></view>
          </view>
        </view>
        <text class="grid-label">{{item.label}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- Shape/Grid Selector -->
  <view class="shape-selector-container">
    <view class="selector-label">选择形状</view>
    <!-- Shape List (Templates) - 3 rows grid -->
    <scroll-view 
      scroll-y 
      class="shape-scroll-vertical" 
      enable-flex 
      bindscrolltolower="onScrollToLower"
    >
      <view class="shape-grid-layout">
        <view 
          class="shape-item {{selectedShape === item.id ? 'active' : ''}}"
          wx:for="{{shapeList}}" 
          wx:key="id"
          bindtap="selectShape"
          data-shape="{{item.id}}"
        >
          <view class="shape-icon-wrapper">
            <image 
              class="shape-icon" 
              src="{{(selectedShape === item.id ? item.activeIconUrl : item.iconUrl) || ''}}"
              mode="aspectFit"
            ></image>
          </view>
        </view>
      </view>
      <view wx:if="{{!hasMore && shapeList.length > 0}}" class="no-more-text">已经是全部模板了</view>
    </scroll-view>
  </view>
  </view>

  <!-- Hidden Canvas for Image Generation -->
  <canvas canvas-id="gridCanvas" style="width: 2000px; height: 2000px; position: fixed; left: -9999px; top: -9999px;"></canvas>

  <!-- 图片来源选择弹窗（统一组件） -->
  <image-source-sheet show="{{showSourceSheet}}" count="{{1}}" sources="{{['album', 'camera']}}"
                      bind:chosen="onSourceChosen" bind:close="closeSourceSheet" />
</view>
