/* pages/moments-copy/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #f0f2f5 100%);
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
}

/* Main Tabs */
.main-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 40rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.main-tab-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #8c929d;
  padding: 16rpx 0;
  position: relative;
  transition: all 0.3s ease;
  font-weight: 500;
}

.main-tab-item.active {
  color: #06B6D4;
  font-weight: 600;
}

.main-tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #06B6D4 0%, #22d3ee 100%);
  border-radius: 3rpx;
}

.tab-content {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* Copywriting Content */
.copywriting-content {
  display: flex;
  flex-direction: column;
  background: transparent;
  flex: 1;
}

.copy-category-scroll {
  white-space: nowrap;
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.copy-category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #5a6069;
  background: #f5f7fa;
  border-radius: 28rpx;
  margin-right: 16rpx;
  transition: all 0.25s ease;
  border: 1rpx solid transparent;
}

.copy-category-item.active {
  background: linear-gradient(135deg, #06B6D4 0%, #0891b2 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.25);
}

.copy-list-scroll {
  flex: 1;
  background: transparent;
  padding: 20rpx 20rpx 0;
}

.moments-item {
  display: flex;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.moments-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.moments-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.moments-nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #06B6D4;
  margin-bottom: 12rpx;
  line-height: 1.2;
}

.moments-text {
  font-size: 28rpx;
  color: #2d3436;
  margin-bottom: 16rpx;
  line-height: 1.6;
  word-break: break-all;
}

.moments-text.collapsed {
  display: -webkit-box !important;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 10rpx;
}

.expand-btn {
  font-size: 26rpx;
  color: #06B6D4;
  margin-bottom: 16rpx;
  font-weight: 500;
  display: inline-block;
}

/* ===== 微信朋友圈图片展示规则 ===== */

.moments-images-box {
  margin-bottom: 16rpx;
}

/* 1张图：宽度自适应，最大占屏幕约2/3，高度按比例 */
.single-image-box {
  max-width: 460rpx;
}

.single-image-wrapper {
  display: inline-block;
  max-width: 460rpx;
  max-height: 600rpx;
  overflow: hidden;
  border-radius: 6rpx;
}

.moments-single-image {
  width: 100%;
  max-width: 460rpx;
  max-height: 600rpx;
  border-radius: 6rpx;
  display: block;
}

/* 竖长图特殊处理 */
.moments-single-image.tall-image {
  max-height: 800rpx;
}

/* 多图网格基础样式 */
.moments-image-grid {
  display: grid;
  gap: 6rpx;
}

/* 2张图：2列，每列约49%宽度 */
.moments-image-grid.grid-2 {
  grid-template-columns: repeat(2, 1fr);
  width: 376rpx;
}

/* 3张图、5-9张图：3列 */
.moments-image-grid.grid-3 {
  grid-template-columns: repeat(3, 1fr);
  width: 560rpx;
}

/* 4张图：2×2网格 */
.moments-image-grid.grid-4 {
  grid-template-columns: repeat(2, 1fr);
  width: 376rpx;
}

/* 网格图片项 - 正方形 */
.moments-grid-image {
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  border-radius: 4rpx;
  background-color: #1b202b;
  position: relative;
  display: block;
  overflow: hidden;
}

.moments-grid-image image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
}

.moments-footer {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.moments-time {
  font-size: 22rpx;
  color: #a0a8b0;
  margin-bottom: 16rpx;
}

.moments-actions {
  display: flex;
  gap: 40rpx;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.moments-action-btn {
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  min-height: 60rpx;
  min-width: 200rpx;
  box-sizing: border-box;
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.copy-btn {
  background: #e0f9ff;
  color: #06B6D4;
  border: 1rpx solid rgba(6, 182, 212, 0.15);
}

.copy-btn:active {
  background: #ccf7ff;
}

.download-btn {
  background: linear-gradient(135deg, #06B6D4 0%, #0891b2 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.25);
}

.download-btn:active {
  opacity: 0.9;
}

.btn-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.copy-hint {
  text-align: center;
  padding: 120rpx 0;
  color: #a0a8b0;
  font-size: 28rpx;
}

/* Navigation Bar */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: transparent;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #2d3436;
}

.back-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #2d3436;
}

.nav-right {
  padding: 10rpx;
}

.menu-icon {
  font-size: 44rpx;
  color: #8c929d;
  font-weight: bold;
}

/* Hint Text */
.hint-text {
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #8c929d;
}

/* Preview Container */
.preview-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
}

.grid-wrapper {
  width: 620rpx;
  height: 620rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  position: relative;
}

.touch-area {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

.square-border {
  border: 1px solid #e8eaed;
}

.grid-image {
  position: absolute;
  top: 0;
  left: 0;
  transition: transform 0.1s linear;
}

/* Placeholder */
.placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}

.placeholder-icon {
  font-size: 100rpx;
  opacity: 0.3;
}

.placeholder-text {
  font-size: 28rpx;
  color: #a0a8b0;
}

/* Grid Lines */
.grid-lines {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.grid-line {
  position: absolute;
  background: rgba(255, 255, 255, 0.5);
}

.grid-line.horizontal {
  width: 100%;
  height: 2rpx;
}

.grid-line.vertical {
  width: 2rpx;
  height: 100%;
}

/* Shape Hint Badge - Positioned at top */
.shape-hint-badge {
  position: absolute;
  top: -45rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #06B6D4 0%, #0891b2 100%);
  color: #fff;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.25);
  z-index: 10;
  font-size: 22rpx;
  white-space: nowrap;
}

.hint-icon {
  font-size: 24rpx;
  line-height: 1;
}

.hint-text {
  font-size: 22rpx;
  font-weight: 500;
}

/* Shape Overlay for Preview */
.shape-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 5;
  display: flex;
  justify-content: center;
  align-items: center;
}

.shape-overlay-image {
  width: 100%;
  height: 100%;
  opacity: 1;
  mix-blend-mode: multiply;
}

/* Shape Selector */
.shape-selector-container {
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.shape-scroll-vertical {
  width: 100%;
  max-height: 360rpx;
}

.shape-grid-layout {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  padding: 8rpx 0;
}

.no-more-text {
  text-align: center;
  font-size: 22rpx;
  color: #c5c9d0;
  padding: 20rpx 0;
}

.shape-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.shape-item.active .shape-icon-wrapper {
  border-color: #06B6D4;
  box-shadow: 0 4rpx 16rpx rgba(6, 182, 212, 0.2);
  background: linear-gradient(135deg, #e0f9ff 0%, #f0fdff 100%);
}

.shape-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  border: 3rpx solid #e8eaed;
  border-radius: 14rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #fff;
  transition: all 0.25s ease;
  overflow: hidden;
}

.shape-icon {
  width: 72rpx;
  height: 72rpx;
}

/* Grid Icons (CSS Drawn) */
.grid-icon-wrapper {
  padding: 14rpx;
}

.mini-grid {
  width: 100%;
  height: 100%;
  display: grid;
  gap: 4rpx;
}

.mini-cell {
  background: #d0d5dd;
  border-radius: 2rpx;
}

.shape-item.active .mini-cell {
  background: #06B6D4;
  opacity: 0.8;
}

/* Action Buttons */
.action-buttons {
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.tip-text {
  text-align: center;
  font-size: 22rpx;
  color: #8c929d;
  margin-bottom: 16rpx;
}

.button-group {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  transition: all 0.2s ease;
}

.select-btn {
  background: #f5f7fa;
  color: #5a6069;
  border: 1rpx solid #e8eaed;
}

.select-btn:active {
  background: #e8eaed;
}

.save-btn {
  background: linear-gradient(135deg, #06B6D4 0%, #0891b2 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(6, 182, 212, 0.25);
}

.save-btn:active {
  opacity: 0.9;
}

.share-btn {
  background: #e0f9ff;
  color: #06B6D4;
  border: 1rpx solid rgba(6, 182, 212, 0.15);
}

.share-btn:active {
  background: #ccf7ff;
}

.action-btn[disabled] {
  opacity: 0.5;
}

/* Ad Banner */
.ad-banner {
  margin: 16rpx 30rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%);
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid rgba(6, 182, 212, 0.1);
}

.ad-content {
  text-align: center;
}

.ad-text {
  font-size: 26rpx;
  color: #5a6069;
  font-weight: 500;
}

/* Dark moments style override */
.container {
  background: #000000;
}

.copywriting-content {
  background: #000000;
}

.copy-category-scroll {
  padding: 26rpx 20rpx;
  background: #000000;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.copy-category-item {
  background: #1e232d;
  color: #c7d0da;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 10rpx 22rpx;
}

.copy-category-item.active {
  background: #2e3441;
  color: hsl(125, 86%, 46%);
  border-color: rgba(5, 153, 17, 0.884);
  box-shadow: none;
}

.copy-list-scroll {
  background: #000000;
  padding: 16rpx 0 24rpx;
}

.moments-item {
  margin: 0;
  padding: 22rpx 22rpx 20rpx;
  border-radius: 0;
  background: #000000;
  border: none;
  box-shadow: none;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.moments-avatar {
  width: 74rpx;
  height: 74rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
}

.moments-nickname {
  font-size: 36rpx;
  color: #7e93be;
  margin-bottom: 30rpx;
  line-height: 1.15;
}

.moments-text {
  font-size: 36rpx;
  color: #e5e7eb;
  line-height: 1.25;
  margin-bottom: 24rpx;
}

.moments-text.collapsed {
  -webkit-line-clamp: 4;
}

.expand-btn {
  color: #9ca3af;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.moments-images-box {
  margin-bottom: 14rpx;
}

.moments-single-image {
  width: 460rpx;
  max-width: 100%;
  border-radius: 6rpx;
  box-shadow: none;
}

.moments-image-grid {
  gap: 6rpx;
  max-width: 560rpx;
}

.moments-image-grid.grid-4 {
  width: 376rpx;
}

.moments-grid-image {
  border-radius: 4rpx;
  background: #1b202b;
}

.moments-grid-image image {
  border-radius: 4rpx;
}

.moments-footer {
  border-top: none;
  padding-top: 0;
  margin-top: 4rpx;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.moments-time {
  margin-bottom: 0;
  font-size: 22rpx;
  color: #8f96a3;
}

.moments-actions {
  justify-content: flex-end;
  width: auto;
  gap: 10rpx;
}

.moments-action-btn {
  min-width: 0;
  min-height: 48rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.copy-btn {
  background: rgba(255, 255, 255, 0.1);
  color: #d1d5db;
  border: none;
}

.download-btn {
  background: rgba(17, 24, 39, 0.9);
  color: #f9fafb;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.16);
}

.btn-icon {
  width: 20rpx;
  height: 20rpx;
}

.copy-hint {
  color: #8f96a3;
}
