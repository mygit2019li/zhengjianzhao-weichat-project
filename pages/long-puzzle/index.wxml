<view class="page">
  <view class="header">
    <text class="title">选择拼接方向</text>
    <text class="subtitle">先选择横向或竖向，再进入拼图编辑</text>
  </view>

  <view class="mode-grid">
    <view class="mode-card" bindtap="goHorizontal">
      <view class="mode-icon">↔</view>
      <text class="mode-title">拼接横图</text>
      <text class="mode-desc">左右拼接，适合横向长图</text>
    </view>

    <view class="mode-card" bindtap="goVertical">
      <view class="mode-icon">↕</view>
      <text class="mode-title">拼接竖图</text>
      <text class="mode-desc">上下拼接，适合竖向长图</text>
    </view>
  </view>

  <!-- 图片来源选择弹窗（统一组件） -->
  <image-source-sheet show="{{showSourceSheet}}" count="{{9}}" sources="{{['album', 'chat', 'camera']}}"
                      bind:chosen="onSourceChosen" bind:close="closeSourceSheet" />
</view>
