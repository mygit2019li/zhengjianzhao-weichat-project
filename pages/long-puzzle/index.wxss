.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: #f6f6f6;
}

.header {
  margin-bottom: 24rpx;
}

.title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2e3d;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.mode-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.mode-card {
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.mode-card:active {
  opacity: 0.85;
}

.mode-icon {
  width: 74rpx;
  height: 74rpx;
  border-radius: 16rpx;
  background: #cffafe;
  color: #06B6D4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}

.mode-title {
  display: block;
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2e3d;
}

.mode-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666;
}
