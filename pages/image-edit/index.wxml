<view class="page">
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-inner">
      <view class="back-btn" bindtap="goBack">返回</view>
      <view class="title">图片编辑</view>
      <view class="top-actions">
        <view class="top-action {{canUndo ? '' : 'disabled'}}" bindtap="onUndo">撤销</view>
        <view class="top-action {{canRedo ? '' : 'disabled'}}" bindtap="onRedo">重做</view>
      </view>
    </view>
  </view>

  <view class="content" style="padding-top: {{navHeight}}px;">
    <view class="preview-shell">
      <view id="previewBox" class="preview-box" bindtap="onPreviewTap">
        <view wx:if="{{baseImage}}" class="base-frame" style="{{baseFrameStyle}}">
          <image
            src="{{baseImage}}"
            class="base-image"
            mode="aspectFit"
            style="{{baseStyle}}"
          ></image>
        </view>

        <view class="layer-list">
          <view
            wx:for="{{layers}}"
            wx:key="id"
            class="layer-item {{activeLayerId === item.id && item.type === 'text' ? 'text-active' : ''}} {{activeLayerId === item.id && item.type === 'image' ? 'image-active' : ''}}"
            data-id="{{item.id}}"
            style="left: {{item.x}}px; top: {{item.y}}px; width: {{item.w}}px; height: {{item.h}}px; transform: rotate({{item.rotation || 0}}deg) scale({{item.type === 'image' && item.flipX ? -1 : 1}}, {{item.type === 'image' && item.flipY ? -1 : 1}});"
            catchtouchstart="onLayerTouchStart"
            catchtouchmove="onLayerTouchMove"
            catchtouchend="onLayerTouchEnd"
            catchtap="onLayerTap"
          >
            <image wx:if="{{item.type === 'image'}}" class="layer-image" src="{{item.src}}" mode="aspectFit"></image>
            <text
              wx:else
              class="layer-text"
              style="line-height: 1.12; font-size: {{item.fontSize}}px; color: {{item.colorRgba}}; font-weight: {{item.bold ? '700' : '200'}};"
            >
              <block wx:for="{{item.lines || [item.text]}}" wx:key="*this">
                <text class="layer-text-line">{{item}}</text>
              </block>
            </text>
            <view
              wx:if="{{activeLayerId === item.id && (item.type === 'text' || item.type === 'image')}}"
              class="text-resize-handle"
              data-id="{{item.id}}"
              catchtouchstart="onResizeHandleStart"
              catchtouchmove="onResizeHandleMove"
              catchtouchend="onResizeHandleEnd"
              catchtouchcancel="onResizeHandleEnd"
            ></view>
            <view
              wx:if="{{activeLayerId === item.id && item.type === 'text'}}"
              class="text-delete-btn"
              data-id="{{item.id}}"
              catchtouchstart="onDeleteLayerTap"
              catchtouchmove="noop"
              catchtouchend="noop"
              catchtap="onDeleteLayerTap"
            >×</view>
          </view>
        </view>

        <view wx:if="{{watermarkPreview.enabled}}" class="watermark-layer">
          <view
            wx:for="{{watermarkPreviewItems}}"
            wx:key="idx"
            class="watermark-item"
            style="left: {{item.x}}px; top: {{item.y}}px; font-size: {{watermarkPreview.size}}px; font-weight: {{watermarkPreview.bold ? '700' : '300'}}; color: {{watermarkPreview.colorRgba}}; transform: translate(-50%, -50%) rotate({{watermarkPreview.angle}}deg);"
          >
            {{watermarkPreview.text}}
          </view>
        </view>
      </view>
    </view>
    <view class="tip-text">拖动贴图/文字可移动，双指缩放旋转；顶部可撤销/重做</view>
  </view>

  <view class="bottom-bar">
    <view class="tool-group">
      <view class="action-item" bindtap="onAddSticker">
        <view class="action-icon-wrap">
          <image src="/images/icon/add-image.svg" class="action-icon" mode="aspectFit"></image>
        </view>
        <text class="action-text">贴图</text>
      </view>
      <view class="action-item" bindtap="onAddText">
        <view class="action-icon-wrap">
          <image src="/images/icon/加字.svg" class="action-icon" mode="aspectFit"></image>
        </view>
        <text class="action-text">加字</text>
      </view>
      <view class="action-item" bindtap="onOpenWatermarkPanel">
        <view class="action-icon-wrap">
          <image src="/images/icon/编辑.svg" class="action-icon" mode="aspectFit"></image>
        </view>
        <text class="action-text">水印</text>
      </view>
      <view class="action-item {{activeLayerId ? '' : 'action-item-disabled'}}" bindtap="onDeleteActiveLayer">
        <view class="action-icon-wrap">
          <image src="/images/icon/编辑.svg" class="action-icon" mode="aspectFit"></image>
        </view>
        <text class="action-text">删除</text>
      </view>
    </view>
    <view class="save-btn" bindtap="onSave">
      <text>保存</text>
    </view>
  </view>

  <view wx:if="{{showTextPanel}}" class="panel-mask" bindtap="closeTextPanel"></view>
  <view wx:if="{{showTextPanel}}" class="setting-panel" catchtap="noop">
    <view class="panel-head">
      <view class="panel-close" bindtap="closeTextPanel">关闭</view>
      <input class="panel-input" placeholder="这里输入文字" value="{{textEditor.text}}" focus="{{showTextPanel}}" bindinput="onTextInput" />
    </view>
    <view class="panel-row">
      <view class="row-label">文字颜色</view>
      <view class="color-list">
        <view
          wx:for="{{colorOptions}}"
          wx:key="value"
          class="color-dot {{textEditor.color === item.value ? 'active' : ''}}"
          style="background: {{item.value}}"
          data-color="{{item.value}}"
          bindtap="onTextColorPick"
        ></view>
      </view>
    </view>
    <view class="panel-row slider-row">
      <text class="slider-label">大小</text>
      <slider min="20" max="96" value="{{textEditor.size}}" show-value bindchange="onTextSizeChange" bindchanging="onTextSizeChange" />
    </view>
    <view class="panel-row slider-row">
      <text class="slider-label">透明度</text>
      <slider min="10" max="100" value="{{textEditor.opacity}}" show-value bindchange="onTextOpacityChange" bindchanging="onTextOpacityChange" />
    </view>
    <view class="panel-row">
      <text class="slider-label">加粗</text>
      <switch checked="{{textEditor.bold}}" bindchange="onTextBoldChange" />
    </view>
  </view>

  <view wx:if="{{showWatermarkPanel}}" class="panel-mask" bindtap="closeWatermarkPanel"></view>
  <view wx:if="{{showWatermarkPanel}}" class="setting-panel wm-panel" catchtap="noop">
    <view class="panel-head">
      <view class="panel-close" bindtap="closeWatermarkPanel">关闭</view>
      <input class="panel-input" placeholder="这里输入水印文字" value="{{watermarkDraft.text}}" bindinput="onWatermarkTextInput" />
    </view>

    <view class="wm-enable-row">
      <text class="wm-enable-label">启用水印</text>
      <switch checked="{{watermarkDraft.enabled}}" bindchange="onWatermarkEnableChange" />
    </view>

    <view class="wm-tabs">
      <view class="wm-tab {{wmActiveTab === 'basic' ? 'active' : ''}}" data-tab="basic" bindtap="onSwitchWmTab">基础</view>
      <view class="wm-tab {{wmActiveTab === 'color' ? 'active' : ''}}" data-tab="color" bindtap="onSwitchWmTab">颜色</view>
      <view class="wm-tab {{wmActiveTab === 'size' ? 'active' : ''}}" data-tab="size" bindtap="onSwitchWmTab">大小</view>
    </view>

    <view wx:if="{{wmActiveTab === 'basic'}}" class="wm-tab-panel">
      <view class="panel-row wm-row">
        <text class="slider-label">位置</text>
        <picker mode="selector" range="{{watermarkPositions}}" range-key="label" value="{{watermarkDraft.positionIndex}}" bindchange="onWatermarkPositionChange">
          <view class="picker-view">{{watermarkPositionLabel}}</view>
        </picker>
      </view>
      <view class="panel-row slider-row wm-row">
        <text class="slider-label">角度</text>
        <slider min="-90" max="90" value="{{watermarkDraft.angle}}" show-value bindchange="onWatermarkAngleChange" bindchanging="onWatermarkAngleChange" />
      </view>
      <view class="panel-row slider-row wm-row">
        <text class="slider-label">间隔</text>
        <slider min="5" max="220" value="{{watermarkDraft.spacing}}" show-value bindchange="onWatermarkSpacingChange" bindchanging="onWatermarkSpacingChange" />
      </view>
    </view>

    <view wx:if="{{wmActiveTab === 'color'}}" class="wm-tab-panel">
      <view class="panel-row wm-row">
        <view class="row-label">颜色</view>
        <view class="color-list wm-color-list">
          <view
            wx:for="{{colorOptions}}"
            wx:key="value"
            class="color-dot wm-color-dot {{watermarkDraft.color === item.value ? 'active' : ''}}"
            style="background: {{item.value}}"
            data-color="{{item.value}}"
            bindtap="onWatermarkColorPick"
          ></view>
        </view>
      </view>
      <view class="panel-row slider-row wm-row">
        <text class="slider-label">透明度</text>
        <slider min="5" max="100" value="{{watermarkDraft.opacity}}" show-value bindchange="onWatermarkOpacityChange" bindchanging="onWatermarkOpacityChange" />
      </view>
    </view>

    <view wx:if="{{wmActiveTab === 'size'}}" class="wm-tab-panel">
      <view class="panel-row wm-row">
        <text class="slider-label">加粗</text>
        <switch checked="{{watermarkDraft.bold}}" bindchange="onWatermarkBoldChange" />
      </view>
      <view class="panel-row slider-row wm-row">
        <text class="slider-label">大小</text>
        <slider min="8" max="72" value="{{watermarkDraft.size}}" show-value bindchange="onWatermarkSizeChange" bindchanging="onWatermarkSizeChange" />
      </view>
    </view>
  </view>

  <view wx:if="{{showAdjustPanel}}" class="panel-mask" bindtap="closeAdjustPanel"></view>
  <view wx:if="{{showAdjustPanel}}" class="setting-panel adjust-panel" catchtap="noop">
    <view class="panel-head">
      <view class="panel-close" bindtap="closeAdjustPanel">关闭</view>
      <view class="panel-title">调整</view>
      <view class="panel-ok" bindtap="closeAdjustPanel">完成</view>
    </view>

    <view class="wm-tabs">
      <view class="wm-tab {{adjustTab === 'image' ? 'active' : ''}}" data-tab="image" bindtap="onSwitchAdjustTab">画面</view>
      <view class="wm-tab {{adjustTab === 'base' ? 'active' : ''}}" data-tab="base" bindtap="onSwitchAdjustTab">背景</view>
      <view class="wm-tab {{adjustTab === 'layer' ? 'active' : ''}}" data-tab="layer" bindtap="onSwitchAdjustTab">图层</view>
    </view>

    <view wx:if="{{adjustTab === 'image'}}" class="wm-tab-panel">
      <view class="panel-row slider-row">
        <text class="slider-label">亮度</text>
        <slider min="20" max="200" value="{{adjustments.brightness}}" show-value data-key="brightness" bindchanging="onAdjustChanging" bindchange="onAdjustChange" />
      </view>
      <view class="panel-row slider-row">
        <text class="slider-label">对比度</text>
        <slider min="20" max="200" value="{{adjustments.contrast}}" show-value data-key="contrast" bindchanging="onAdjustChanging" bindchange="onAdjustChange" />
      </view>
      <view class="panel-row slider-row">
        <text class="slider-label">饱和度</text>
        <slider min="0" max="200" value="{{adjustments.saturation}}" show-value data-key="saturation" bindchanging="onAdjustChanging" bindchange="onAdjustChange" />
      </view>
      <view class="panel-row">
        <text class="slider-label">还原</text>
        <view class="adjust-reset" bindtap="resetAdjustments">恢复默认</view>
      </view>
    </view>

    <view wx:if="{{adjustTab === 'base'}}" class="wm-tab-panel">
      <view class="panel-row slider-row">
        <text class="slider-label">大小</text>
        <slider min="20" max="300" value="{{baseTransform.scale}}" show-value bindchanging="onBaseScaleChanging" bindchange="onBaseScaleChange" />
      </view>
      <view class="panel-row slider-row">
        <text class="slider-label">旋转</text>
        <slider min="-180" max="180" value="{{baseTransform.rotation}}" show-value bindchanging="onBaseRotationChanging" bindchange="onBaseRotationChange" />
      </view>
      <view class="panel-row">
        <text class="slider-label">翻转</text>
        <view class="layer-btn-group">
          <view class="layer-btn {{baseTransform.flipX ? 'active' : ''}}" data-axis="x" bindtap="onToggleBaseFlip">水平</view>
          <view class="layer-btn {{baseTransform.flipY ? 'active' : ''}}" data-axis="y" bindtap="onToggleBaseFlip">垂直</view>
        </view>
      </view>
      <view class="panel-row">
        <text class="slider-label">还原</text>
        <view class="adjust-reset" bindtap="resetBaseTransform">恢复默认</view>
      </view>
    </view>

    <view wx:if="{{adjustTab === 'layer'}}" class="wm-tab-panel">
      <block wx:if="{{layerEditor.id}}">
        <view class="panel-row slider-row">
          <text class="slider-label">大小</text>
          <slider min="20" max="300" value="{{layerEditor.size}}" show-value bindchanging="onLayerSizeChanging" bindchange="onLayerSizeChange" />
        </view>
        <view class="panel-row slider-row">
          <text class="slider-label">旋转</text>
          <slider min="-180" max="180" value="{{layerEditor.rotation}}" show-value bindchanging="onLayerRotationChanging" bindchange="onLayerRotationChange" />
        </view>
        <view class="panel-row slider-row">
          <text class="slider-label">透明度</text>
          <slider min="10" max="100" value="{{layerEditor.opacity}}" show-value bindchanging="onLayerOpacityChanging" bindchange="onLayerOpacityChange" />
        </view>
        <view wx:if="{{layerEditor.type === 'image'}}" class="panel-row">
          <text class="slider-label">翻转</text>
          <view class="layer-btn-group">
            <view class="layer-btn {{layerEditor.flipX ? 'active' : ''}}" data-axis="x" bindtap="onToggleLayerFlip">水平</view>
            <view class="layer-btn {{layerEditor.flipY ? 'active' : ''}}" data-axis="y" bindtap="onToggleLayerFlip">垂直</view>
          </view>
        </view>
        <view class="panel-row">
          <text class="slider-label">层级</text>
          <view class="layer-btn-group">
            <view class="layer-btn" data-dir="up" bindtap="onMoveLayer">上移</view>
            <view class="layer-btn" data-dir="down" bindtap="onMoveLayer">下移</view>
          </view>
        </view>
      </block>
      <view wx:else class="adjust-empty">请先在画面中选中一个图层</view>
    </view>
  </view>

  <canvas
    type="2d"
    canvas-id="editCanvas"
    class="render-canvas"
    style="width: {{renderWidth}}px; height: {{renderHeight}}px;"
  ></canvas>
</view>
