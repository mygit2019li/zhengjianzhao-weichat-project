<view class="index-container">
  <view class="content-wrapper">
    <view class="home-title-bar">
      <text class="home-title-text">拼九宫格图</text>
    </view>

    <!-- Hero Banner (Swiper) -->
    <view class="hero-section">
      <swiper 
        class="banner-swiper" 
        indicator-dots="{{false}}" 
        autoplay="{{true}}" 
        interval="4000" 
        duration="500"
        circular="{{true}}"
        indicator-color="rgba(255, 255, 255, 0.6)"
        indicator-active-color="#ffffff"
      >
        <block wx:for="{{banners}}" wx:key="id">
          <swiper-item>
            <view class="banner-item" bindtap="onBannerTap" data-link="{{item.link}}" data-type="{{item.type}}">
              <image src="{{item.url}}" mode="aspectFill" class="hero-cover"></image>
              <view class="hero-mask"></view>
            </view>
          </swiper-item>
        </block>
        <!-- Fallback if no banners -->
        <block wx:if="{{banners.length === 0}}">
            <swiper-item>
                <view class="banner-item" bindtap="handleHomeCardTap" data-action="startQuickPuzzle">
                    <image src="{{hero.cover}}" mode="aspectFill" class="hero-cover"></image>
                    <view class="hero-mask"></view>
                </view>
            </swiper-item>
        </block>
      </swiper>
    </view>

    <view class="home-body">
      <add-tips name="拼九宫格图" duration="3" delay="1" custom="{{true}}" />

      <!-- 主导航卡片区域 - 宫格拼图 + 证件照/抠图 -->
      <view class="primary-layout">
        <!-- 左侧大卡片 - 宫格拼图 -->
        <view class="primary-main-card" bindtap="handleHomeCardTap" data-action="{{primaryCards[0].action}}">
          <view class="primary-main-text">
            <text class="primary-main-title">{{primaryCards[0].title}}</text>
            <text class="primary-main-subtitle">{{primaryCards[0].subtitle}}</text>
          </view>
          <!-- 三宫格图片展示 -->
          <view class="puzzle-preview-grid">
            <image src="{{primaryCards[0].image}}" mode="aspectFill" class="puzzle-preview-img puzzle-img-1"></image>
            <image src="{{primaryCards[0].image}}" mode="aspectFill" class="puzzle-preview-img puzzle-img-2"></image>
            <image src="{{primaryCards[0].image}}" mode="aspectFill" class="puzzle-preview-img puzzle-img-3"></image>
          </view>
        </view>

        <!-- 右侧两个小卡片 -->
        <view class="primary-side-col">
          <!-- 拍证件照 -->
          <view class="primary-side-card side-card-green" bindtap="handleHomeCardTap" data-action="{{primaryCards[1].action}}">
            <view class="primary-side-text">
              <text class="primary-side-title">{{primaryCards[1].title}}</text>
              <text class="primary-side-subtitle">{{primaryCards[1].subtitle}}</text>
            </view>
            <image src="{{primaryCards[1].image}}" mode="aspectFill" class="primary-side-image"></image>
          </view>
          <!-- 抠人换背景 -->
          <view class="primary-side-card side-card-orange" bindtap="handleHomeCardTap" data-action="{{primaryCards[2].action}}">
            <view class="primary-side-text">
              <text class="primary-side-title">{{primaryCards[2].title}}</text>
              <text class="primary-side-subtitle">{{primaryCards[2].subtitle}}</text>
            </view>
            <image src="{{primaryCards[2].image}}" mode="aspectFill" class="primary-side-image"></image>
          </view>
        </view>
      </view>

      <!-- 第二行卡片 - 朋友圈文案 + 生日日历 -->
      <view class="secondary-layout">
        <!-- 朋友圈文案 - 紫色渐变 -->
        <view class="secondary-card card-moments" bindtap="goToMomentsCopy">
          <view class="secondary-content">
            <view class="secondary-icon-wrap">
              <image src="/images/icon/moments-line.svg" mode="aspectFit" class="secondary-icon"></image>
            </view>
            <view class="secondary-text">
              <text class="secondary-title">朋友圈文案</text>
              <text class="secondary-subtitle">精选文案一键复制</text>
            </view>
          </view>
          <view class="secondary-decoration">
            <view class="deco-circle c1"></view>
            <view class="deco-circle c2"></view>
          </view>
        </view>
        <!-- 生日日历 - 粉色渐变 -->
        <view class="secondary-card card-birthday" bindtap="goToBirthdayCalendar">
          <view class="secondary-content">
            <view class="secondary-icon-wrap">
              <image src="/images/icon/calendar-line.svg" mode="aspectFit" class="secondary-icon"></image>
            </view>
            <view class="secondary-text">
              <text class="secondary-title">生日日历</text>
              <text class="secondary-subtitle">记录重要纪念日</text>
            </view>
          </view>
          <view class="secondary-decoration">
            <view class="deco-circle c1"></view>
            <view class="deco-circle c2"></view>
          </view>
        </view>
      </view>

      <!-- 工具网格 -->
      <view class="tool-grid">
        <view wx:for="{{toolGrid}}" wx:key="id" class="tool-item" bindtap="handleHomeCardTap" data-action="{{item.action}}">
          <view class="tool-icon-wrap">
            <image src="{{item.icon}}" mode="aspectFit" class="tool-icon"></image>
          </view>
          <text class="tool-title">{{item.title}}</text>
        </view>
      </view>

      <!-- 宝藏修图神器标题 -->
      <view class="topic-header">
        <view class="topic-title-decoration left">🌸</view>
        <text class="topic-title">宝藏修图神器</text>
        <view class="topic-title-decoration right">🌸</view>
      </view>

      <!-- 主题卡片网格 -->
      <view class="topic-grid">
        <view wx:for="{{topicCards}}" wx:key="id" class="topic-card topic-{{item.theme}}" bindtap="handleHomeCardTap" data-action="{{item.action}}">
          <text class="topic-card-title">{{item.title}}</text>
          <text class="topic-card-subtitle">{{item.subtitle}}</text>
        </view>
      </view>
    </view>

    <canvas type="2d" id="homePuzzleCanvas" class="offscreen-canvas"></canvas>
  </view>

  <!-- 图片来源选择弹窗 -->
  <view class="action-sheet-mask {{showPuzzleSourceSheet ? 'show' : ''}}" bindtap="closePuzzleSourceSheet"></view>
  <view class="action-sheet-panel {{showPuzzleSourceSheet ? 'show' : ''}}">
    <!-- 关闭按钮 - 右上角 -->
    <view class="action-close-btn" bindtap="closePuzzleSourceSheet">
      <image src="/images/icon/close.svg" class="close-icon" mode="aspectFit"></image>
    </view>
    
    <!-- 装饰顶部 -->
    <view class="action-sheet-decoration">
      <view class="deco-line"></view>
    </view>
    
    <view class="action-header">
      <text class="action-title">请选择图片来源</text>
      <text class="action-subtitle">支持从多个渠道选择图片</text>
    </view>
    
    <view class="action-options">
      <!-- 从相册选择 -->
      <view class="action-item" bindtap="onChooseAlbum">
        <view class="action-icon-box album">
          <image src="/images/icon/add-image.svg" class="action-icon" mode="aspectFit"></image>
        </view>
        <text class="action-text">从相册选择</text>
      </view>
      
      <!-- 聊天记录 -->
      <view class="action-item" bindtap="onChooseChat">
        <view class="action-icon-box chat">
          <image src="/images/icon/wechat-line.svg" class="action-icon" mode="aspectFit"></image>
        </view>
        <text class="action-text">聊天记录</text>
      </view>
      
      <!-- 拍照 -->
      <view class="action-item" bindtap="onChooseCamera">
        <view class="action-icon-box camera">
          <image src="/images/icon/拍照.svg" class="action-icon" mode="aspectFit"></image>
        </view>
        <text class="action-text">拍照</text>
      </view>
    </view>
  </view>
</view>
