.index-container {
  width: 100%;
  min-height: 100vh;
  background: #f6f6f6;
  overflow-x: hidden;
}

.content-wrapper {
  width: 100%;
  padding: 0 0 calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.home-title-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-bottom: 1rpx solid #eceff3;
}

.home-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 1rpx;
}

/* Hero Banner */
.hero-section {
  width: 100%;
  height: 520rpx;
  position: relative;
  overflow: hidden;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.hero-cover {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0%, rgba(28, 52, 77, 0.15) 100%);
  pointer-events: none;
}

/* Home Body */
.home-body {
  padding: 16rpx 22rpx 0;
  box-sizing: border-box;
}

/* 主导航卡片区域 - 宫格拼图 + 证件照/抠图 */
.primary-layout {
  margin-top: 22rpx;
  display: flex;
  gap: 16rpx;
}

/* 左侧大卡片 - 宫格拼图 */
.primary-main-card {
  flex: 1;
  min-height: 380rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #cffafe 0%, #ecfeff 100%);
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(22, 119, 255, 0.08);
}

.primary-main-text {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.primary-main-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d2b3a;
  line-height: 1.2;
}

.primary-main-subtitle {
  font-size: 20rpx;
  color: #8b9aab;
}

/* 三宫格图片展示 */
.puzzle-preview-grid {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 18rpx;
  height: 198rpx;
  display: flex;
  gap: 8rpx;
}

.puzzle-preview-img {
  flex: 1;
  height: 100%;
  border-radius: 12rpx;
  object-fit: cover;
}

.puzzle-img-1 {
  transform: rotate(-3deg);
}

.puzzle-img-2 {
  transform: rotate(2deg);
  margin-top: -8rpx;
}

.puzzle-img-3 {
  transform: rotate(-2deg);
}

/* 右侧两个小卡片 */
.primary-side-col {
  width: 44%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.primary-side-card {
  flex: 1;
  min-height: 182rpx;
  border-radius: 24rpx;
  padding: 20rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 22rpx rgba(15, 54, 94, 0.09);
}

/* 拍证件照 - 浅蓝色 */
.side-card-green {
  background: linear-gradient(135deg, #cffafe 0%, #ffffff 100%);
  border: 1px solid rgba(6, 182, 212, 0.08);
}

/* 抠人换背景 - 浅橙色 */
.side-card-orange {
  background: linear-gradient(135deg, #feecde 0%, #ffffff 100%);
  border: 1px solid rgba(255, 149, 2, 0.08);
}

.primary-side-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  width: 58%;
  min-width: 0;
  position: relative;
  z-index: 2;
}

.primary-side-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2e3d;
  line-height: 1.2;
}

.primary-side-subtitle {
  font-size: 18rpx;
  color: #7f8f9f;
}

.primary-side-image {
  width: 116rpx;
  height: 116rpx;
  border-radius: 14rpx;
  position: absolute;
  right: 16rpx;
  bottom: 14rpx;
  object-fit: cover;
}

/* 第二行卡片 - 朋友圈文案 + 生日日历 */
.secondary-layout {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.secondary-card {
  flex: 1;
  min-height: 160rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 朋友圈文案 - 绿色渐变 */
.card-moments {
  background: linear-gradient(135deg, #e6f7ed 0%, #f0fdf4 50%, #f5fef8 100%);
  border: 1px solid rgba(74, 222, 128, 0.15);
}

/* 生日日历 - 粉色渐变 */
.card-birthday {
  background: linear-gradient(135deg, #ffe6f0 0%, #fff0f5 50%, #fff5f8 100%);
  border: 1px solid rgba(251, 182, 206, 0.15);
}

/* 证件加水印 - 蓝色渐变 */
.card-id-watermark {
  background: linear-gradient(135deg, #cffafe 0%, #f0f9ff 50%, #ecfeff 100%);
  border: 1px solid rgba(6, 182, 212, 0.15);
}

.secondary-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 2;
}

.secondary-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-moments .secondary-icon-wrap {
  background: linear-gradient(135deg, #4ade80 0%, #86efac 100%);
  box-shadow: 0 4rpx 12rpx rgba(74, 222, 128, 0.3);
}

.card-birthday .secondary-icon-wrap {
  background: linear-gradient(135deg, #f472b6 0%, #f9a8d4 100%);
  box-shadow: 0 4rpx 12rpx rgba(244, 114, 182, 0.3);
}

.card-id-watermark .secondary-icon-wrap {
  background: linear-gradient(135deg, #06B6D4 0%, #38bdf8 100%);
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.3);
}

.secondary-icon {
  width: 36rpx;
  height: 36rpx;
  filter: brightness(0) invert(1);
}

.secondary-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.secondary-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2e3d;
  line-height: 1.2;
}

.secondary-subtitle {
  font-size: 20rpx;
  color: #6b7280;
}

/* 装饰圆形 */
.secondary-decoration {
  position: absolute;
  right: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
}

.card-moments .deco-circle {
  background: linear-gradient(135deg, #22c55e 0%, #4ade80 100%);
}

.card-birthday .deco-circle {
  background: linear-gradient(135deg, #ec4899 0%, #f472b6 100%);
}

.deco-circle.c1 {
  width: 120rpx;
  height: 120rpx;
  right: -30rpx;
  top: -30rpx;
}

.deco-circle.c2 {
  width: 80rpx;
  height: 80rpx;
  right: 50rpx;
  bottom: -20rpx;
}

/* 工具网格 */
.tool-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.tool-item {
  background: #ffffff;
  border-radius: 20rpx;
  min-height: 138rpx;
  padding: 16rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 18rpx rgba(15, 54, 94, 0.07);
}

.tool-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-icon {
  width: 48rpx;
  height: 48rpx;
}

.tool-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #233446;
  text-align: center;
  line-height: 1.2;
}

/* 宝藏修图神器标题 */
.topic-header {
  margin-top: 26rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
}

.topic-title-decoration {
  font-size: 32rpx;
  opacity: 0.8;
}

.topic-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2e3d;
  letter-spacing: 2rpx;
}

/* 主题卡片网格 */
.topic-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.topic-card {
  background: #fff;
  border-radius: 24rpx;
  min-height: 164rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.topic-card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2e3d;
  line-height: 1.2;
}

.topic-card-subtitle {
  font-size: 22rpx;
  color: #5f6f81;
}

.topic-yellow {
  background: linear-gradient(135deg, #fffcf0 0%, #fff 100%);
  border: 1px solid rgba(255, 230, 100, 0.1);
}

.topic-mint {
  background: linear-gradient(135deg, #f0fffa 0%, #fff 100%);
  border: 1px solid rgba(100, 255, 200, 0.1);
}

.topic-purple {
  background: linear-gradient(135deg, #f9f5ff 0%, #fff 100%);
  border: 1px solid rgba(180, 150, 255, 0.1);
}

.topic-pink {
  background: linear-gradient(135deg, #fff0f5 0%, #fff 100%);
  border: 1px solid rgba(255, 150, 180, 0.1);
}

/* 隐藏画布 */
.offscreen-canvas {
  width: 1px;
  height: 1px;
  position: fixed;
  left: -9999px;
  top: -9999px;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .hero-section {
    height: 460rpx;
  }

  .primary-main-title,
  .primary-side-title {
    font-size: 30rpx;
  }

  .tool-title {
    font-size: 22rpx;
  }

  .topic-title {
    font-size: 36rpx;
  }

  .topic-card-title {
    font-size: 32rpx;
  }
}

/* 底部动作面板 */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.action-sheet-mask.show {
  opacity: 1;
  visibility: visible;
}

.action-sheet-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
  border-radius: 48rpx 48rpx 0 0;
  padding: 30rpx 40rpx 60rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 2001;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
}

.action-sheet-panel.show {
  transform: translateY(0);
}

/* 关闭按钮 - 右上角 */
.action-close-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(8rpx);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
  z-index: 10;
}

.action-close-btn:active {
  background: rgba(255, 255, 255, 0.8);
  transform: scale(0.9);
}

.close-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
  filter: grayscale(100%);
}

/* 顶部装饰线 */
.action-sheet-decoration {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.deco-line {
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #e5e7eb 0%, #d1d5db 50%, #e5e7eb 100%);
  border-radius: 3rpx;
}

.action-header {
  text-align: center;
  margin-bottom: 50rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  letter-spacing: 1rpx;
}

.action-subtitle {
  font-size: 24rpx;
  color: #9ca3af;
}

.action-options {
  display: flex;
  justify-content: space-around;
  margin-bottom: 50rpx;
  padding: 0 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  transition: transform 0.2s ease;
}

.action-item:active {
  transform: scale(0.95);
  background: rgba(0, 0, 0, 0.02);
}

.action-icon-box {
  width: 130rpx;
  height: 130rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.action-icon-box::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 36rpx;
  padding: 2rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0) 50%);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
}

/* 相册 - 蓝色 */
.action-icon-box.album {
  background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35);
}

/* 聊天 - 绿色 */
.action-icon-box.chat {
  background: linear-gradient(135deg, #22c55e 0%, #4ade80 100%);
  box-shadow: 0 8rpx 24rpx rgba(34, 197, 94, 0.35);
}

/* 拍照 - 橙色 */
.action-icon-box.camera {
  background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, 0.35);
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
  filter: brightness(0) invert(1);
}

.action-text {
  font-size: 26rpx;
  color: #4b5563;
  font-weight: 500;
}

/* 操作按钮区域 */
.moment-actions {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 12rpx 40rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  transition: all 0.3s;
  min-width: 160rpx;
}
