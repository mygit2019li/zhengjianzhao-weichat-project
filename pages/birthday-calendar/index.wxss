.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f6f6f6;
}

.top-panel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(22, 30, 46, 0.06);
}

.date-picker {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2333;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #f4f6fb;
}

.ratio-group {
  display: flex;
  border-radius: 14rpx;
  overflow: hidden;
  background: #f4f6fb;
}

.ratio-item {
  width: 120rpx;
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx 0;
  color: #3d4860;
}

.ratio-item.active {
  background: #06B6D4;
  color: #ffffff;
}

.preview-panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(22, 30, 46, 0.06);
  display: flex;
  justify-content: center;
}

.style-panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(22, 30, 46, 0.06);
}

.style-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.style-row:last-child {
  margin-bottom: 0;
}

.style-label {
  font-size: 26rpx;
  color: #3d4860;
  width: 120rpx;
  font-weight: 500;
}

.color-scroll {
  flex: 1;
  white-space: nowrap;
  width: 0;
}

.color-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx;
}

.style-slider {
  flex: 1;
  margin: 0 0 0 10rpx;
}

.guide-panel {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f3f6fc;
  border: 1rpx solid #e3eaf7;
}

.guide-title {
  margin-bottom: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #25304a;
}

.guide-item {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #58637d;
}

.preset-scroll {
  margin-top: 10rpx;
  white-space: nowrap;
}

.preset-list {
  display: inline-flex;
  gap: 12rpx;
  padding-bottom: 6rpx;
}

.preset-item {
  width: 152rpx;
  height: 114rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  flex-shrink: 0;
  box-sizing: border-box;
}

.preset-item.active {
  border-color: #06B6D4;
  box-shadow: 0 0 0 2rpx rgba(6, 182, 212, 0.2);
}

.preset-image {
  width: 100%;
  height: 100%;
}

.poster-preview {
  width: 660rpx;
  position: relative;
  overflow: hidden;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 40rpx rgba(15, 23, 42, 0.2);
}

.ratio-square {
  height: 660rpx;
}

.ratio-3-4 {
  height: 880rpx;
}

.ratio-3-4 .grid {
  height: calc(100% - 246rpx);
}

.ratio-3-4 .day-touch-grid {
  top: 270rpx;
}

.ratio-4-3 {
  width: 100%;
  max-width: 880rpx;
  height: 495rpx;
}

.ratio-4-3 .grid {
  height: calc(100% - 132rpx);
}

.ratio-4-3 .day-touch-grid {
  top: 144rpx;
  bottom: 38rpx;
}

.ratio-4-3 .calendar-layer {
  padding: 44rpx 26rpx 28rpx;
}

.ratio-4-3 .month-label {
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.ratio-4-3 .week-header {
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.ratio-4-3 .day-cell {
  font-size: 24rpx;
}

.ratio-4-3 .lunar-text {
  font-size: 14rpx;
  margin-top: 0;
  line-height: 1.05;
}

.ratio-4-3 .day-wrap {
  width: 64rpx;
  height: 64rpx;
}

.ratio-4-3 .day-text {
  font-size: 22rpx;
}

.bg-layer,
.calendar-layer,
.sticker-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.bg-layer {
  z-index: 1;
}

.day-touch-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 5;
}

.day-touch-layer.hidden {
  pointer-events: none;
}

.day-touch-grid {
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  top: 164rpx;
  bottom: 26rpx;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  grid-template-rows: repeat(6, 1fr);
}



.day-touch-cell {
  width: 100%;
  height: 100%;
}

.sticker-layer {
  z-index: 3;
}

.calendar-layer {
  z-index: 4;
  pointer-events: none;
}

.bg-image {
  position: absolute;
  left: 0;
  top: 0;
}

.bg-fallback {
  width: 100%;
  height: 100%;
  background:
    radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.28) 0, rgba(255, 255, 255, 0) 42%),
    radial-gradient(circle at 85% 30%, rgba(255, 255, 255, 0.3) 0, rgba(255, 255, 255, 0) 36%),
    linear-gradient(130deg, #ffc6a9 0%, #ff9f9f 45%, #ffa4d0 100%);
}

.calendar-layer {
  padding: 50rpx 26rpx 26rpx;
  box-sizing: border-box;
  background: transparent;
}

.month-text {
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.week-row {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.week-cell {
  text-align: center;
  font-size: 22rpx;
}

.grid {
  margin-top: 10rpx;
  height: calc(100% - 140rpx);
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  grid-template-rows: repeat(6, 1fr);
}

.grid-cell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.day-wrap {
  width: 74rpx;
  height: 74rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.day-mark {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 5rpx solid #ff4f66;
  background: rgba(255, 79, 102, 0.16);
}

.day-text {
  font-size: 24rpx;
  font-weight: 600;
}

.lunar-text {
  margin-top: 2rpx;
  font-size: 16rpx;
  opacity: 0.82;
  line-height: 1;
}

.sticker-item {
  position: absolute;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  transform-origin: center center;
}

.sticker-item.active {
  border-color: #06B6D4;
}

.sticker-image {
  width: 100%;
  height: 100%;
}

.sticker-handle {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  color: #ffffff;
  text-align: center;
  line-height: 36rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.sticker-delete {
  right: -18rpx;
  top: -18rpx;
  background: #ff3b30;
}

.sticker-scale {
  left: -18rpx;
  bottom: -18rpx;
  background: #06B6D4;
}

.sticker-rotate {
  right: -18rpx;
  bottom: -18rpx;
  background: #ff9500;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #f6f6f6;
  border-top: 1rpx solid #e8ecf4;
  z-index: 30;
}

.settings-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(10, 16, 28, 0.35);
  z-index: 40;
}

.settings-popup {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 40rpx rgba(14, 23, 36, 0.22);
  overflow: hidden;
  color: #1d2333;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #ecf0f7;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2333;
}

.popup-close {
  font-size: 28rpx;
  color: #657089;
  padding: 8rpx 12rpx;
}

.popup-scroll {
  max-height: calc(80vh - 90rpx);
  padding: 20rpx 24rpx 28rpx;
  box-sizing: border-box;
}

.section + .section {
  margin-top: 24rpx;
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2333;
}

.color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.color-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.color-dot.active {
  border-color: #06B6D4;
  transform: scale(1.08);
}

.alpha-row {
  margin-top: 12rpx;
}

.alpha-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  color: #3f4a63;
}

.action-row {
  display: flex;
  gap: 14rpx;
}

.btn {
  flex: 1;
  border: none;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 500;
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-popup .section-title,
.settings-popup .alpha-label,
.settings-popup .btn,
.settings-popup .popup-close {
  letter-spacing: 0;
}

.btn::after {
  border: none;
}

.btn.plain {
  background: #eef3ff;
  color: #06B6D4;
}

.btn.danger {
  background: #ffeceb;
  color: #d93025;
}

.btn.primary {
  background: #06B6D4;
  color: #ffffff;
}

.render-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}
