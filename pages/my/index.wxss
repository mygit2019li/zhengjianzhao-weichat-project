/* 个人中心页面样式 - 统一配色 */
.container {
  min-height: 100vh;
  background-color: #f6f6f6;
  display: flex;
  flex-direction: column;
  padding: 0;
  margin: 0;
}

/* 顶部背景区域 - 改为蓝色渐变风格 */
.top-background {
  background: linear-gradient(135deg, #06B6D4 0%, #06B6D4 50%, #38bdf8 100%);
  padding: 80rpx 40rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 240rpx;
  box-sizing: border-box;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
  position: relative;
  overflow: hidden;
}

/* 添加光泽效果 */
.top-background::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 200%;
  background: linear-gradient(
    to bottom right,
    rgba(255, 255, 255, 0.2) 0%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: rotate(30deg);
}

/* 用户信息行 */
.user-info-row {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 30rpx;
}

/* 用户头像容器 */
.user-avatar-container {
  margin-right: 30rpx;
  position: relative;
}

/* 用户头像 - 优化样式 */
.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background-color: #fff;
  padding: 5rpx;
  /* 添加多层阴影效果 */
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  /* Added cleaner border */
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  /* 添加悬停效果 */
  transition: all 0.3s ease;
}

.user-avatar:active {
  transform: scale(0.95);
  box-shadow: 
    0 2rpx 10rpx rgba(0, 0, 0, 0.1),
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.8);
}

/* 用户问候区域 */
.user-greeting {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 问候行 */
.greeting-row {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

/* Hi文本 */
.hi-text {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  margin-right: 10rpx;
}

/* 姓名文本 */
.name-text {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  margin-right: 10rpx;
  /* 添加文字阴影 */
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 编辑图标 */
.edit-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.8;
  /* 添加悬停效果 */
  transition: all 0.3s ease;
}

.edit-icon:active {
  opacity: 1;
  transform: scale(1.1);
}

/* 陪伴文本 */
.accompany-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.4;
  /* 添加文字阴影 */
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

/* 登录/登出区域 */
.login-logout-area {
  align-self: flex-end;
  margin-top: -20rpx;
  z-index: 100;
  position: relative;
}

/* 登录按钮 - 优化样式 */
.login-btn {
  background-color: #fff;
  color: #252629;
  font-size: 30rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  font-weight: 600;
}

.login-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
}

/* 登出按钮 - 优化样式 */
.logout-btn {
  background-color: rgba(255, 255, 255, 0.15);
  color: #fff;
  font-size: 28rpx;
  padding: 15rpx 45rpx;
  border-radius: 25rpx;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.logout-btn:active {
  background-color: rgba(255, 255, 255, 0.25);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

/* 下方白色卡片 - 统一卡片样式 */
.function-card {
  background-color: #fff;
  margin: 0 30rpx;
  border-radius: 24rpx;
  padding: 40rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-top: -50rpx;
  z-index: 10;
  width: calc(100% - 60rpx);
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.function-card:active {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

/* 探索模块 - 统一卡片样式 */
.explore-card {
  background-color: #fff;
  margin: 24rpx 30rpx 0;
  border-radius: 24rpx;
  padding: 26rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.explore-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.explore-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2e3d;
}

.explore-subtitle {
  font-size: 22rpx;
  color: #999;
}

.explore-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.explore-item {
  display: flex;
  align-items: center;
  padding: 14rpx 10rpx;
  border-radius: 14rpx;
  transition: all 0.2s ease;
}

.explore-item:active {
  background: rgba(0, 0, 0, 0.05);
}

.explore-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #f5f6f8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.explore-icon {
  width: 34rpx;
  height: 34rpx;
}

.explore-text-box {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.explore-item-title {
  font-size: 28rpx;
  color: #1f2e3d;
  font-weight: 600;
}

.explore-item-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #666;
}

/* 功能行 */
.function-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
}

/* 最后一行功能行 */
.function-row:last-child {
  margin-bottom: 0;
}

/* 功能项 - 优化样式 */
.function-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  /* 添加点击反馈 */
  padding: 10rpx;
  border-radius: 15rpx;
  transition: all 0.3s ease;
}

.function-item:active {
  background-color: rgba(0, 0, 0, 0.05);
}

/* 客服按钮样式 - 确保和其他功能项一致 */
.contact-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  padding: 10rpx;
  border-radius: 15rpx;
  transition: all 0.3s ease;
}

.contact-btn:active {
  background-color: rgba(0, 0, 0, 0.05);
}

/* 移除按钮的默认样式 */
.contact-btn::after {
  border: none;
}

/* 空功能项 */
.function-item.empty {
  visibility: hidden;
}

/* 功能图标容器 - 优化样式 */
.function-icon {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.function-item:active .function-icon {
  background-color: rgba(0, 0, 0, 0.08);
  transform: scale(0.95);
}

/* 图标图片 - 优化样式 */
.icon-image {
  width: 50rpx;
  height: 50rpx;
  opacity: 0.9;
  /* 添加动画效果 */
  transition: all 0.3s ease;
}

.function-item:active .icon-image {
  opacity: 1;
  transform: scale(1.1);
}

/* 功能文本 - 优化样式 */
.function-text {
  font-size: 28rpx;
  color: #1f2e3d;
  text-align: center;
  font-weight: 500;
}

/* 其他功能 - 优化样式 */
.other-functions {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 60rpx 40rpx 30rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 40rpx;
}

/* 其他功能项 */
.other-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 添加点击反馈 */
  padding: 15rpx 25rpx;
  border-radius: 15rpx;
  transition: all 0.3s ease;
}

.other-item:active {
  background-color: rgba(0, 0, 0, 0.05);
}

/* 其他功能文字 - 优化样式 */
.other-text {
  font-size: 24rpx;
  color: #999;
  transition: all 0.3s ease;
}

.other-item:active .other-text {
  color: #333;
  transform: translateY(-1rpx);
}

/* 版本信息 - 优化样式 */
.version {
  display: flex;
  justify-content: center;
  margin-bottom: 60rpx;
  margin-top: 20rpx;
}

/* 版本文字 - 优化样式 */
.version-text {
  font-size: 24rpx;
  color: #999;
  /* 添加文字阴影 */
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
}
