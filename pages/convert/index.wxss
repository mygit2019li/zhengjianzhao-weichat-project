/* pages/convert/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f8f8f8;
  padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  margin-bottom: 40rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
}

.preview-area {
  flex: 1;
  background: linear-gradient(135deg, #f0f0f0 0%, #e8e8e8 100%);
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 32rpx;
  border: 2rpx dashed #d0d0d0;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.file-info {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background-color: rgba(0,0,0,0.65);
  color: #fff;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  backdrop-filter: blur(4rpx);
}

.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.5;
}

.add-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.controls-area {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.format-selector {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
  font-weight: 500;
}

.radio-group {
  display: flex;
  justify-content: space-around;
  gap: 16rpx;
}

.radio-label {
  flex: 1;
  height: 76rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  color: #666;
  font-size: 28rpx;
  transition: all 0.2s ease;
  background-color: #fafafa;
}

.radio-label:active {
  background-color: #f0f0f0;
}

.radio-label.active {
  border-color: #06B6D4;
  color: #06B6D4;
  background-color: rgba(6, 182, 212, 0.08);
  font-weight: 600;
}

.btn-group {
  display: flex;
  gap: 24rpx;
}

.btn-group button {
  flex: 1;
  font-size: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  margin: 0;
  border-radius: 42rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.btn-group button:active {
  transform: scale(0.96);
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #555;
  border: 2rpx solid #e8e8e8;
}

.btn-secondary:active {
  background-color: #ebebeb;
}

.btn-primary {
  background: linear-gradient(135deg, #06B6D4 0%, #0891b2 100%);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(6, 182, 212, 0.35);
  border: none;
}

.btn-primary:active {
  box-shadow: 0 4rpx 12rpx rgba(6, 182, 212, 0.25);
}

.offscreen-canvas {
  position: absolute;
  left: -9999px;
  top: -9999px;
  width: 100px;
  height: 100px;
}