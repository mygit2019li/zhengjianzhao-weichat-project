<view class="container">
  <view class="header">
    <text class="title">格式转换</text>
    <text class="subtitle">支持 JPG / PNG 互转</text>
  </view>

  <!-- 图片预览：空状态 -->
  <view class="preview-area" wx:if="{{!imagePaths.length}}" bindtap="chooseImage">
    <view class="placeholder">
      <image src="/images/icon/add-image.svg" class="add-icon"></image>
      <text>点击选择图片（最多 20 张）</text>
    </view>
  </view>

  <!-- 图片预览：已选缩略图网格（可逐张删除 / 放大查看） -->
  <block wx:else>
    <view class="grid-summary">已选 {{imagePaths.length}}/20 张 · 当前格式 {{currentFormat}}</view>
    <scroll-view scroll-y class="image-grid-wrap">
      <view class="image-grid">
        <view class="grid-item" wx:for="{{imagePaths}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" class="thumb" bindtap="previewImage" data-index="{{index}}"></image>
          <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">
            <image src="/images/icon/close.svg" class="delete-icon"></image>
          </view>
        </view>
      </view>
    </scroll-view>
  </block>

  <!-- 控制区域 -->
  <view class="controls-area" wx:if="{{imagePaths.length}}">
    <view class="format-selector">
      <text class="section-title">目标格式</text>
      <radio-group class="radio-group" bindchange="onFormatChange">
        <label class="radio-label {{targetFormat === 'jpg' ? 'active' : ''}}">
          <radio value="jpg" checked="{{targetFormat === 'jpg'}}" hidden/>
          <text>JPG</text>
        </label>
        <label class="radio-label {{targetFormat === 'png' ? 'active' : ''}}">
          <radio value="png" checked="{{targetFormat === 'png'}}" hidden/>
          <text>PNG</text>
        </label>
      </radio-group>
    </view>

    <view class="btn-group">
      <button class="btn-secondary" bindtap="chooseImage">重选（最多20张）</button>
      <button class="btn-primary" bindtap="convertAndSave">批量转换并保存</button>
    </view>
  </view>

  <!-- 隐藏 Canvas 用于转换 -->
  <canvas type="2d" id="convertCanvas" class="offscreen-canvas"></canvas>

  <!-- 图片来源选择弹窗（统一组件） -->
  <image-source-sheet show="{{showSourceSheet}}" count="{{20}}" sources="{{['album', 'chat', 'camera']}}"
                      bind:chosen="onSourceChosen" bind:close="closeSourceSheet" />
</view>
