/* 全局样式 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 30rpx 20rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 表单卡片 */
.form-card {
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 40rpx;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

/* 标签 */
.label {
  font-size: 28rpx;
  color: #666;
  width: 120rpx;
  flex-shrink: 0;
}

/* 输入框 */
.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 0;
  border: none;
  outline: none;
  text-align: right;
  background: transparent;
}

.input::placeholder {
  color: #999;
}

/* 只读输入框 */
.input.readonly {
  color: #999;
}

/* 单位 */
.unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
  flex-shrink: 0;
}

/* 保存按钮 */
.save-btn {
  background-color: #333;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  margin: 0 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  cursor: pointer;
  transition: background-color 0.3s;
}

.save-btn:active {
  background-color: #555;
}

/* 按钮文本 */
.btn-text {
  color: white;
}