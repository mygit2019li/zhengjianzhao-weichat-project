/* Action Buttons */
.action-buttons {
  padding: 20rpx 30rpx;
  margin-top: 5rpx;
}

.tip-text {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.button-group {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
}

.select-btn {
  background: #252629;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.save-btn {
  background: linear-gradient(135deg, #ff9f6b 0%, #ff7f50 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 127, 80, 0.25);
}

.share-btn {
  background: #ffece3;
  color: #ff7f50;
}

.action-btn[disabled] {
  opacity: 0.5;
}

/* Ad Banner */
.ad-banner {
  margin: 20rpx 30rpx;
  height: 160rpx;
  background: #f0f2f5;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  border: 1rpx solid #eee;
}

.ad-content {
  text-align: center;
}

.ad-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

