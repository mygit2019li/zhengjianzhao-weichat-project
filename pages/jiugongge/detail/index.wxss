.container {
  min-height: 100vh;
  background: #000;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 40rpx;
}

.copy-box {
  background: #1a1a1a;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.5);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.copy-text {
  font-size: 32rpx;
  color: #fff;
  line-height: 1.6;
  white-space: pre-wrap;
  display: block;
  margin-bottom: 24rpx;
  text-align: center;
}

.copy-btn {
  display: inline-block;
  font-size: 24rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
}

.grid-container {
  /* flex: 1; */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  width: 600rpx;
  background: #1a1a1a;
  padding: 12rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.6);
}

.grid-item {
  position: relative;
  width: 188rpx;
  height: 188rpx;
  background: #2c2c2c;
  border-radius: 8rpx;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
}

.grid-image {
  width: 100%;
  height: 100%;
}

.grid-placeholder .plus {
  font-size: 60rpx;
  color: #444;
}

.hint {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #666;
}

.footer {
  margin-top: 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.save-btn {
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  height: 88rpx;
  width: 90% !important;
  margin: 0 auto;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
  white-space: nowrap;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #444;
  margin-top: 24rpx;
}

/* Action Sheet */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.7);
  z-index: 1000;
}

.action-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #1a1a1a;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1001;
  transform: translateY(100%);
  transition: transform 0.3s ease-out;
  padding-bottom: env(safe-area-inset-bottom);
}

.action-sheet.show {
  transform: translateY(0);
}

.action-item {
  height: 110rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  color: #fff;
  border-bottom: 1rpx solid #333;
}

.action-item:active {
  background: #252525;
}

.action-item.cancel {
  border-bottom: none;
  color: #999;
  border-top: 12rpx solid #000;
}
