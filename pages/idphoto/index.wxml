    <!-- 抠图图像 -->
    <view class="result-row" style="display: block; margin-bottom: 20rpx; width: 100%; box-sizing: border-box; overflow: hidden;">
      <view class="result-item" style="width: 48% !important; margin-right: 4% !important; margin-bottom: 16rpx !important; background-color: #3f3f46; border-radius: 12rpx; padding: 16rpx; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.5); display: block !important; float: left !important; overflow: hidden; box-sizing: border-box !important; border: none !important; flex: none !important;">
        <view class="result-item-header">
          <text class="result-item-title">透明高清照1</text>
          <view class="result-image-actions">
            <view class="result-image-btn fullscreen" bindtap="fullscreenImage" data-type="transparent-standard">
              <image src="/images/icon/全屏.svg" mode="aspectFit" class="result-image-btn-icon"></image>
            </view>
            <view class="result-image-btn download" bindtap="downloadImage" data-type="transparent-standard">
              <image src="/images/icon/下载.svg" mode="aspectFit" class="result-image-btn-icon"></image>
            </view>
          </view>
        </view>
        <view class="result-item-image-container">
          <image wx:if="{{makeTransparentImage}}" src="{{makeTransparentImage}}" mode="aspectFit" class="result-item-image"></image>
        </view>
      </view>
      <view class="result-item" style="width: 48% !important; margin-bottom: 16rpx !important; background-color: #3f3f46; border-radius: 12rpx; padding: 16rpx; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.5); display: block !important; float: left !important; overflow: hidden; box-sizing: border-box !important; border: none !important; flex: none !important;">
        <view class="result-item-header">
          <text class="result-item-title">透明高清照2</text>
          <view class="result-image-actions">
            <view class="result-image-btn fullscreen" bindtap="fullscreenImage" data-type="transparent-hd">
              <image src="/images/icon/全屏.svg" mode="aspectFit" class="result-image-btn-icon"></image>
            </view>
            <view class="result-image-btn download" bindtap="downloadImage" data-type="transparent-hd">
              <image src="/images/icon/下载.svg" mode="aspectFit" class="result-image-btn-icon"></image>
            </view>
          </view>
        </view>
        <view class="result-item-image-container">
          <image wx:if="{{makeTransparentImageHd}}" src="{{makeTransparentImageHd}}" mode="aspectFit" class="result-item-image"></image>
        </view>
      </view>
      <view style="clear: both;"></view>
    </view>
    
    <!-- 操作按钮 -->
    <view class="result-actions">
      <view class="result-action-btn reset" bindtap="resetMaking">重新制作</view>
      <view class="result-action-btn save" bindtap="saveImage">保存到相册</view>
    </view>
  </view>
  
  <!-- 证件照换底色结果展示模块 -->
  <view class="result-module" wx:if="{{showChangeBgResultModule && currentModule === 'changeBg'}}">
    <!-- 只显示一张证件照 -->
    <view class="result-row" style="display: block; margin-bottom: 20rpx; width: 100%; box-sizing: border-box; overflow: hidden;">
      <view class="result-item" style="width: 100% !important; margin-bottom: 16rpx !important; background-color: #3f3f46; border-radius: 12rpx; padding: 16rpx; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.5); display: block !important; float: left !important; overflow: hidden; box-sizing: border-box !important; border: none !important; flex: none !important;">
        <view class="result-item-header">
          <text class="result-item-title">证件照</text>
          <view class="result-image-actions">
            <view class="result-image-btn fullscreen" bindtap="fullscreenImage" data-type="standard">
              <image src="/images/icon/全屏.svg" mode="aspectFit" class="result-image-btn-icon"></image>
            </view>
            <view class="result-image-btn download" bindtap="downloadImage" data-type="standard">
              <image src="/images/icon/下载.svg" mode="aspectFit" class="result-image-btn-icon"></image>
            </view>
          </view>
        </view>
        <view class="result-item-image-container">
          <image src="{{changeBgResultImage}}" mode="aspectFit" class="result-item-image"></image>
        </view>
      </view>
      <view style="clear: both;"></view>
    </view>
    
    <!-- 操作按钮 -->
    <view class="result-actions">
      <view class="result-action-btn reset" bindtap="resetMaking">重新制作</view>
      <view class="result-action-btn save" bindtap="saveImage">保存到相册</view>
    </view>
  </view>
  

  <!-- 用于绘制带有背景色证件照的临时canvas -->
  <canvas canvas-id="tempCanvas" style="width: 500px; height: 600px; position: absolute; left: -9999px; top: -9999px;" width="500" height="600"></canvas>
  <!-- 用于排版照生成的隐藏canvas -->
  <canvas canvas-id="layoutCanvas" style="width: 3600px; height: 3600px; position: absolute; left: -9999px; top: -9999px;" width="3600" height="3600"></canvas>

  <!-- 全屏预览弹窗 - 用于排版照横屏展示 -->
  <view class="fullscreen-preview" wx:if="{{showFullscreenPreview}}" bindtap="closeFullscreenPreview">
    <view class="fullscreen-preview-content {{fullscreenIsLandscape ? 'landscape' : ''}}" catchtap="preventClose">
      <view class="fullscreen-preview-header">
        <text class="fullscreen-preview-title">排版照预览</text>
        <view class="fullscreen-preview-close" bindtap="closeFullscreenPreview">
          <text>×</text>
        </view>
      </view>
      <view class="fullscreen-preview-body">
        <image 
          src="{{fullscreenImagePath}}" 
          mode="aspectFit" 
          class="fullscreen-preview-image {{fullscreenIsLandscape ? 'landscape-image' : ''}}"
          show-menu-by-longpress
        ></image>
      </view>
      <view class="fullscreen-preview-footer">
        <text class="fullscreen-preview-tip">点击任意位置关闭</text>
      </view>
    </view>
  </view>

  <!-- 自定义尺寸选择弹窗 -->
  <view class="custom-modal" wx:if="{{showSizeModal}}">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">{{modalTitle}}</text>
        <view class="close-btn" bindtap="hideSizeModal">×</view>
      </view>
      <view class="modal-body">
        <view class="modal-size-list">
          <view wx:for="{{modalSizes}}" wx:key="id" class="modal-size-item" bindtap="selectModalSize" data-size="{{item.id}}">
            <text>{{item.name}} ({{item.size}})</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
