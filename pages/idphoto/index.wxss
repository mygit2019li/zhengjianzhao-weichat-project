  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
}

.crop-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
}

.crop-frame {
  position: absolute;
  border: 2rpx solid #06B6D4;
  background-color: transparent;
  box-shadow: inset 0 0 0 9999rpx rgba(0, 0, 0, 0.5);
}

.crop-controls {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  gap: 20rpx;
  z-index: 20;
}

.crop-btn {
  padding: 15rpx 30rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.2s;
}

.crop-btn.cancel {
  background-color: #f5f5f5;
  color: #666;
  border: 1rpx solid #eee;
}

.crop-btn.confirm {
  background-color: #06B6D4;
  color: white;
}

.crop-btn:active {
  opacity: 0.8;
}

/* 裁剪控制点样式 */
.crop-handle {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  background-color: #06B6D4;
  border: 2rpx solid white;
  border-radius: 50%;
  z-index: 15;
}

.crop-handle.top-left {
  top: -10rpx;
  left: -10rpx;
  cursor: nwse-resize;
}

.crop-handle.top-right {
  top: -10rpx;
  right: -10rpx;
  cursor: nesw-resize;
}

.crop-handle.bottom-left {
  bottom: -10rpx;
  left: -10rpx;
  cursor: nesw-resize;
}

.crop-handle.bottom-right {
  bottom: -10rpx;
  right: -10rpx;
  cursor: nwse-resize;
}
