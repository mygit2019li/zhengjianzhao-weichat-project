.section {
  margin: 20rpx 0;
}

/* 覆盖全局标题样式，设置为左对齐 */
.title {
  text-align: left;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.upload-preview-container {
  /* 宽度减小20%，从100%改为80% */
  width: 55%;
  /* 设置宽高比为3:4 */
  padding-top: 73%; /* 4/3 ≈ 1.3333，即133.33% */
  position: relative;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  background-color: #fafafa;
  overflow: hidden;
  cursor: pointer;
  /* 居中显示 */
  margin: 0 auto;
}

.make-upload-layout {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin: 20rpx 0;
}

.make-preview-section {
  flex: 1;
  margin: 0;
}

.make-preview-section .upload-preview-container {
  width: 68%;
  padding-top: 90%;
  margin: 0;
}

.upload-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #999;
  font-size: 32rpx;
}

/* 上传按钮图标样式 */
.upload-btn-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
  color: #666;
}

/* 上传按钮文字样式 */
.upload-btn-text {
  font-size: 28rpx;
  color: #999;
}

/* 上传图标容器样式（平铺按钮已改为统一来源弹窗入口） */

/* 上传按钮容器 */
.upload-buttons {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}

/* 统一上传入口：占据整行宽度 */
.unified-upload {
  width: 100%;
  max-width: 560rpx;
  padding-top: 0;
  height: 480rpx;
}

/* 上传图标样式 */
.upload-icon {
  font-size: 40rpx;
  color: #666;
  text-align: center;
}

.upload-btn text {
  position: relative;
  top: auto;
  left: auto;
  transform: none;
}

.preview-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* 上传备注样式 */
.upload-note {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
  font-style: italic;
}
.size-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  /* 确保容器占满可用宽度 */
  width: 100%;
  box-sizing: border-box;
  padding: 0;
  /* 确保内容从左到右排列 */
  justify-content: flex-start;
}

.size-item {
  padding: 20rpx 5rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 21rpx;
  text-align: center;
  /* 一行展示三个尺寸，精确计算宽度 */
  width: calc(33.33% - 8rpx);
  box-sizing: border-box;
  background-color: #fafafa;
  /* 确保尺寸项为块级元素 */
  display: block;
  /* 移除可能的额外边距 */
  margin: 0;
  /* 强制不换行 */
  white-space: nowrap;
  /* 限制文本溢出 */
  overflow: hidden;
  text-overflow: ellipsis;
}

.size-item.active {
  border-color: #06B6D4;
  background-color: #e8f4fd;
  color: #06B6D4;
}

/* 特殊尺寸项样式 */
.size-item.special {
  border-color: #ff4d4f;
  background-color: #fff5f5;
  color: #ff4d4f;
  font-weight: bold;
}

.size-item.special:active {
  background-color: #ffebee;
}

/* 选中的特殊尺寸样式 */
.size-item.special-selected {
  border-color: #06B6D4;
  background-color: #e8f4fd;
  color: #06B6D4;
  font-weight: bold;
  border-width: 3rpx;
}

/* 自定义弹窗样式 */
.custom-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.modal-content {
  width: 80%;
  max-height: 80%;
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background-color: #f8f8f8;
  border-bottom: 2rpx solid #eee;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 48rpx;
  color: #999;
  cursor: pointer;
  padding: 0 16rpx;
}

.close-btn:active {
  color: #666;
}

.modal-body {
  padding: 24rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.modal-size-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.modal-size-item {
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 32rpx;
  text-align: left;
  background-color: #fafafa;
  cursor: pointer;
  transition: all 0.2s;
}

.modal-size-item:active {
  background-color: #e8f4fd;
  border-color: #06B6D4;
  color: #06B6D4;
}

/* 证件照预览样式 */
.result-preview-container {
  /* 宽度减小20%，从100%改为80% */
  width: 80%;
  /* 设置宽高比为3:4 */
  padding-top: 133.33%; /* 4/3 ≈ 1.3333，即133.33% */
  position: relative;
  margin-top: 20rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  overflow: hidden;
  border: 1rpx solid #eee;
  /* 居中显示 */
  margin-left: auto;
  margin-right: auto;
}

.result-preview-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.result-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}

.result-actions .btn {
  width: 100%;
  max-width: 400rpx;
}

.color-list {
  display: flex;
  gap: 30rpx;
  margin: 30rpx 20rpx;
  /* 允许换行，适应6个颜色选项 */
  flex-wrap: wrap;
  justify-content: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 新样式的颜色列表 */
.color-list.new-style {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin: 20rpx;
  padding: 20rpx;
  background-color: transparent;
  box-shadow: none;
  border-radius: 0;
}

.extended-color-list {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
  margin-top: 30rpx;
  /* 居中对齐，适应6个颜色选项 */
  justify-content: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 美颜功能样式 */
.beauty-section {
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

/* 美颜项目 */
.beauty-item {
  margin-bottom: 30rpx;
}

.beauty-item:last-child {
  margin-bottom: 0;
}

/* 美颜标题行 */
.beauty-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

/* 美颜标签 */
.beauty-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 美颜值容器 */
.beauty-value-container {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

/* 美颜值 */
.beauty-value {
  font-size: 28rpx;
  color: #06B6D4;
  font-weight: bold;
}

/* 重置按钮 */
.beauty-reset {
  font-size: 24rpx;
  color: #999;
  cursor: pointer;
  padding: 5rpx 10rpx;
  border-radius: 50%;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 滑块容器 */
.slider-container {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

/* 滑块最小值 */
.slider-min {
  font-size: 24rpx;
  color: #666;
  width: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

/* 美颜滑块 */
.beauty-slider {
  flex: 1;
}

/* 滑块最大值 */
.slider-max {
  font-size: 24rpx;
  color: #666;
  width: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

/* 美颜行，用于并排展示亮度、对比度、饱和度 */
.beauty-row {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

/* 小尺寸美颜项目 */
.beauty-item-small {
  flex: 1;
  min-width: 200rpx;
  margin-bottom: 20rpx;
}

/* 水印功能样式 */
.watermark-section {
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

/* 水印切换 */
.watermark-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
  padding: 8rpx;
  border-radius: 8rpx;
}

.watermark-toggle-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.toggle-options {
  display: flex;
  gap: 40rpx;
}

.toggle-option {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

/* 水印切换单选按钮样式 */
.toggle-option radio {
  transform: scale(1.0);
  margin-right: 10rpx;
  font-size: 26rpx;
}

/* 自定义水印切换单选按钮样式 */
.toggle-option radio .wx-radio-input {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  background-color: #fff;
  transition: all 0.3s ease;
}

/* 自定义水印切换单选按钮选中样式 */
.toggle-option radio .wx-radio-input.wx-radio-input-checked {
  border-color: #06B6D4;
  background-color: #fff;
}

/* 自定义水印切换单选按钮选中标记 */
.toggle-option radio .wx-radio-input.wx-radio-input-checked::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #06B6D4;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}
/* 水印行容器 */
.watermark-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

/* 水印项目 */
.watermark-item {
  flex: 1;
  min-width: 200rpx;
  margin-bottom: 10rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 8rpx;
}

.watermark-item:last-child {
  margin-bottom: 0;
}

/* 水印标签 */
.watermark-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
}

/* 水印输入框 */
.watermark-input {
  width: 90%;
  font-size: 21rpx;
  border: 1rpx solid #ddd;
  border-radius: 3rpx;
  box-sizing: border-box;
  background-color: #fafafa;
}

/* 水印颜色选择器 */
.watermark-color-picker {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.watermark-color {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  cursor: pointer;
}

/* 水印标题行 */
.watermark-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

/* 水颜值容器 */
.watermark-value-container {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

/* 水颜值 */
.watermark-value {
  font-size: 28rpx;
  color: #06B6D4;
  font-weight: bold;
}

/* 水印重置按钮 */
.watermark-reset {
  font-size: 24rpx;
  color: #999;
  cursor: pointer;
  padding: 5rpx 10rpx;
  border-radius: 50%;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 水印滑块 */
.watermark-slider {
  flex: 1;
}

/* 水印文字项目特殊样式 */
.watermark-item-text {
  flex: 2;
}

/* 水印颜色项目特殊样式 */
.watermark-item-color {
  flex: 1;
}

/* 统一水印页面样式与美颜页面一致 */
.watermark-section.compact {
  padding: 10rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.watermark-row.compact {
  gap: 15rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.watermark-item.compact {
  margin-bottom: 10rpx;
  padding: 10rpx;
  background-color: transparent;
}

.watermark-item.small {
  flex: 1;
  min-width: 200rpx;
  margin-bottom: 10rpx;
  padding: 10rpx;
  background-color: transparent;
}

.watermark-header.compact {
  margin-bottom: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.watermark-label.compact {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}

.watermark-value-container.compact {
  gap: 15rpx;
  display: flex;
  align-items: center;
}

.watermark-value.compact {
  font-size: 20rpx;
  color: #06B6D4;
  font-weight: bold;
}

.watermark-reset.compact {
  font-size: 24rpx;
  color: #999;
  cursor: pointer;
  padding: 5rpx 10rpx;
  border-radius: 50%;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.slider-container.compact {
  gap: 15rpx;
  display: flex;
  align-items: center;
}

.slider-min.compact,
.slider-max.compact {
  font-size: 24rpx;
  color: #666;
  width: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

/* 水印参数行 */
.watermark-params-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

/* 颜色选择器样式 */
.color-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.8);
}

.color-picker-modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.color-picker-modal-content.advanced {
  position: relative;
  background-color: #222;
  border-radius: 8rpx;
  padding: 20rpx;
  width: 90%;
  max-width: 500rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5);
}

.color-picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  text-align: center;
}

/* 主颜色选择区域 */
.color-picker-main {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

/* 颜色选择器渐变区域 */
.color-picker-gradient {
  position: relative;
  width: 400rpx;
  height: 400rpx;
  background: linear-gradient(to top, #000, transparent),
              linear-gradient(to right, #fff, hsl(0, 100%, 50%));
  border-radius: 4rpx;
  cursor: pointer;
  overflow: hidden;
  margin: 0 auto;
}

.color-picker-gradient-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to right, transparent, #fff);
}

/* 颜色选择器指示器 */
.color-picker-selector {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 2rpx solid #fff;
  box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.8);
  transform: translate(-50%, -50%);
  z-index: 10;
}

.color-picker-selector-inner {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #fff;
  margin: 2rpx;
  border: 2rpx solid #000;
  border-radius: 50%;
}

/* 颜色滑块容器 */
.color-picker-slider-container {
  width: 100%;
  display: flex;
  justify-content: center;
}

/* 颜色滑块 */
.color-picker-slider {
  position: relative;
  width: 400rpx;
  height: 30rpx;
  border-radius: 15rpx;
  cursor: pointer;
  overflow: hidden;
}

/* 颜色滑块渐变 */
.color-picker-slider-gradient {
  width: 100%;
  height: 100%;
  background: linear-gradient(to right, 
    #ff0000 0%, 
    #ffff00 17%, 
    #00ff00 33%, 
    #00ffff 50%, 
    #0000ff 67%, 
    #ff00ff 83%, 
    #ff0000 100%);
}

/* 颜色滑块指示器 */
.color-picker-slider-selector {
  position: absolute;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  background-color: #fff;
  box-shadow: 0 0 10rpx rgba(0, 0, 0, 0.5);
}

.color-picker-slider-selector-inner {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #ff0000;
  margin: 4rpx;
}

/* 颜色值和预览区域 */
.color-picker-value-section {
  display: flex;
  gap: 15rpx;
  align-items: center;
  margin-top: 20rpx;
}

/* 颜色预览 */
.color-picker-preview {
  width: 100rpx;
  height: 100rpx;
  border-radius: 4rpx;
  overflow: hidden;
  border: 2rpx solid #444;
  background-color: #fff;
}

.color-picker-preview-color {
  width: 100%;
  height: 100%;
  background-color: #ffffff;
}

/* 颜色值输入区域 */
.color-picker-input-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* 颜色值输入框 */
.color-picker-input {
  width: 100%;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: #fff;
  background-color: #333;
  border: 2rpx solid #444;
  border-radius: 4rpx;
  box-sizing: border-box;
  font-family: monospace;
}

/* 颜色格式标签 */
.color-picker-format-tabs {
  display: flex;
  gap: 5rpx;
  margin-top: 10rpx;
}

.color-picker-format-tab {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: #aaa;
  background-color: #333;
  border-radius: 4rpx;
  cursor: pointer;
  transition: all 0.3s ease;
}

.color-picker-format-tab.active {
  color: #fff;
  background-color: #444;
  border: 2rpx solid #666;
}

/* 打印排版样式 */
.print-section {
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

/* 相纸选择区域 */
.paper-select-section {
  padding: 20rpx;
  margin-bottom: 20rpx;
}

/* 相纸选择标题 */
.paper-select-title {
  display: block;
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

/* 相纸选项容器 */
.paper-options {
  display: flex;
  gap: 8rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

/* 相纸选项容器滚动条隐藏 */
.paper-options::-webkit-scrollbar {
  display: none;
}

/* 相纸选项 */
.paper-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  background-color: #fff;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #666;
  cursor: pointer;
  transition: all 0.3s ease;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 选中的相纸选项 */
.paper-option.active {
  background-color: #fff;
  color: #06B6D4;
  border-color: #06B6D4;
}

/* 相纸选项中的单选按钮 */
.paper-option radio {
